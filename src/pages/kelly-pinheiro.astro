/* Foto (LCP no computador): a cortina continua, mas sem opacity 0 no começo,
   para a foto já contar como pintada no primeiro quadro. */
@keyframes kp-foto-entra { from { clip-path: inset(0 0 0 30%); } to { clip-path: inset(0); } }

