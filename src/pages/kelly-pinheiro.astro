  min-height: 100vh; min-height: 100svh; overflow: hidden;
  display: flex; align-items: flex-end;
}
.kp-ab-foto {
  position: absolute; top: 0; right: 0; bottom: 0; width: 56%;
  overflow: hidden;
  animation: kp-foto-entra 1.6s cubic-bezier(.22,1,.36,1) both;
}
.kp-ab-foto::before {
  content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(90deg, var(--dark) 0%, rgba(21,18,16,.55) 18%, rgba(21,18,16,0) 42%),
              linear-gradient(0deg, rgba(21,18,16,.75) 0%, rgba(21,18,16,0) 40%);
}
.kp-ab-foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }
