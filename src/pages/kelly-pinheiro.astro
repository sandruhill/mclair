<style>
/* Perfil de revista: tipografia em escala de capa, fotos que sangram até a
   borda, fundos claro, escuro e vermelho se alternando. */
/* Quanto uma foto precisa avançar para encostar na borda da tela, a partir
   de dentro do .container (que é centralizado e tem a gutter). */
.kp-abertura, .kp-visao, .kp-mentorias, .kp-servicos, .kp-fim { --sangria: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter))); }
figure { margin: 0; }
figure img { width: 100%; height: 100%; object-fit: cover; display: block; }
.kp-acoes { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
.kp-titulo {
  font-size: clamp(2rem, 4vw, 3.4rem);
  font-weight: 900; line-height: 1.04; letter-spacing: -.04em;
  color: var(--ink); text-wrap: balance; margin-bottom: 28px;
}
.kp-titulo-grande { font-size: clamp(2.6rem, 5.4vw, 5rem); }
.kp-titulo-capa { font-size: clamp(3rem, 8.5vw, 8rem); line-height: .95; letter-spacing: -.05em; }
.kp-titulo-claro { color: #fff; }
.kp-titulo-centro { text-align: center; margin-left: auto; margin-right: auto; max-width: 760px; }
.kp-vermelho { color: var(--red); }
.kp-btn-contorno {
  display: inline-flex; align-items: center;
  font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #fff; border: 1.5px solid rgba(255,255,255,.35);
  padding: .85rem 1.9rem; border-radius: var(--r-sm);
  transition: border-color .2s, transform .2s;
}
.kp-btn-contorno:hover { border-color: #fff; transform: translateY(-2px); }
.kp-btn-branco {
  display: inline-flex; align-items: center;
  font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--red); background: #fff;
  padding: .85rem 1.9rem; border-radius: var(--r-sm);
  transition: transform .2s, box-shadow .2s;
}
.kp-btn-branco:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0,0,0,.18); }

/* Revelação: só esconde quando o script confirma que vai revelar. */
:global(html.kp-js) .kp-reveal { opacity: 0; transform: translateY(28px); transition: opacity .9s cubic-bezier(.22,1,.36,1), transform .9s cubic-bezier(.22,1,.36,1); }
:global(html.kp-js) .kp-reveal.in { opacity: 1; transform: none; }
:global(html.kp-js) .kp-reveal:nth-child(2) { transition-delay: .08s; }
:global(html.kp-js) .kp-reveal:nth-child(3) { transition-delay: .16s; }
@media (min-width: 641px) { [data-kp-px] { will-change: transform; transform: scale(1.12); } }

/* ABERTURA */
.kp-abertura {
