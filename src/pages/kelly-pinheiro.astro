}
.kp-nome-linha { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
/* Nome e resumo da abertura já nascem visíveis: são o maior texto da
   primeira tela (LCP) e não podem esperar animação de entrada. */
.kp-nome-inner { display: inline-block; }
.kp-nome-linha:nth-child(2) .kp-nome-inner { padding-left: .18em; }
.kp-lead {
