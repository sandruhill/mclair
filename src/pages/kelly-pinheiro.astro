      </form>

      <div class="kp-fim-acoes kp-reveal">
        <a href={`mailto:${EMAIL}`} class="kp-link-claro">{EMAIL}</a>
        <a href={LINKEDIN} class="kp-link-claro" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<script is:inline data-astro-rerun>
(function () {
  var reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var raiz = document.documentElement;

  // Revelação suave no scroll. Sem JS (ou com movimento reduzido) tudo já
  // nasce visível; a classe kp-js é o que liga o estado inicial escondido.
  var revela = document.querySelectorAll('.kp-reveal');
  if (!reduz && 'IntersectionObserver' in window && revela.length) {
    raiz.classList.add('kp-js');
    var obs = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    revela.forEach(function (el) { obs.observe(el); });
  }

  // A foto da história acompanha o trecho que está no meio da tela.
  var fotos = document.querySelectorAll('#kp-hist-fotos .kp-hist-foto');
  var trechos = document.querySelectorAll('[data-foto]');
  if (fotos.length && trechos.length && 'IntersectionObserver' in window) {
    var obsFoto = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var chave = e.target.getAttribute('data-foto');
        fotos.forEach(function (f) { f.classList.toggle('ativa', f.getAttribute('data-foto-chave') === chave); });
      });
    }, { rootMargin: '-40% 0px -45% 0px', threshold: 0 });
    trechos.forEach(function (t) { obsFoto.observe(t); });
  }

  // Parallax leve nas fotos grandes: deslocam poucos pixels conforme a
  // distância ao centro da tela. Nada disso roda com movimento reduzido.
  var px = Array.prototype.slice.call(document.querySelectorAll('[data-kp-px]'));
  if (px.length && !reduz && window.matchMedia('(min-width: 641px)').matches) {
    var pedido = false;
    function anda() {
      pedido = false;
      var vh = window.innerHeight;
      px.forEach(function (img) {
        var r = img.parentElement.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) return;
        var f = parseFloat(img.getAttribute('data-kp-px')) || 0.05;
        var d = (r.top + r.height / 2 - vh / 2) * -f;
        img.style.transform = 'translate3d(0,' + d.toFixed(1) + 'px,0) scale(1.12)';
      });
    }
    function pede() { if (!pedido) { pedido = true; requestAnimationFrame(anda); } }
    window.addEventListener('scroll', pede, { passive: true });
    window.addEventListener('resize', pede);
    anda();
  }

  // Formulário do fechamento: abre o WhatsApp com a mensagem pronta.
  var form = document.getElementById('wa-form-kelly');
  if (form && !form.dataset.ligado) {
    form.dataset.ligado = '1';
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var nome = (form.nome.value || '').trim();
      var zap = (form.whatsapp.value || '').trim();
      var assunto = form.assunto.value || 'Contato';
      if (!nome) { form.nome.focus(); return; }
      var msg = 'Olá Kelly! Meu nome é ' + nome + '. Assunto: ' + assunto + '.' + (zap ? ' Meu WhatsApp: ' + zap + '.' : '') + ' Vim pela sua página no site da Mclair.';
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'wa_form_submit', form_id: 'wa-form-kelly', assunto: assunto });
      // E-mail para a Kelly sem esperar resposta; o WhatsApp abre no mesmo clique.
      if (window.McContato) window.McContato.enviarEmail({
        formulario: 'wa-form-kelly', nome: nome, telefone: zap, assunto: assunto,
        mensagem: 'Veio pela página da Kelly. Assunto: ' + assunto + '.'
      });
      window.open('https://wa.me/5511988600372?text=' + encodeURIComponent(msg), '_blank', 'noopener,noreferrer');
    });
  }
})();
</script>

