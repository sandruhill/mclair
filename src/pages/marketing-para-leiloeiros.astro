<script is:inline define:vars={{ WA_NUMBER }}>
(function () {
  var form = document.getElementById('leiloes-form');
  if (!form) return;

  function setError(id, msg) {
    var el = document.getElementById(id);
    el.classList.add('field-error');
    var err = el.parentElement.querySelector('.err-msg');
    if (!err) {
      err = document.createElement('span');
      err.className = 'err-msg';
      el.parentElement.appendChild(err);
    }
    err.textContent = msg;
  }
  function clearError(id) {
    var el = document.getElementById(id);
    el.classList.remove('field-error');
    var err = el.parentElement.querySelector('.err-msg');
    if (err) err.textContent = '';
  }
  function isValidEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()); }

  ['lf-nome', 'lf-empresa', 'lf-whats', 'lf-email'].forEach(function (id) {
    var el = document.getElementById(id);
    el.addEventListener('input', function () { clearError(id); });
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var nome = document.getElementById('lf-nome').value.trim();
    var empresa = document.getElementById('lf-empresa').value.trim();
    var whats = document.getElementById('lf-whats').value.trim();
    var email = document.getElementById('lf-email').value.trim();
    var desafio = document.getElementById('lf-desafio').value;

    var valid = true;
    ['lf-nome', 'lf-empresa', 'lf-whats', 'lf-email'].forEach(clearError);
    if (!nome) { setError('lf-nome', 'Informe seu nome.'); valid = false; }
    if (!empresa) { setError('lf-empresa', 'Informe o nome do leiloeiro.'); valid = false; }
    if (!whats) { setError('lf-whats', 'Informe seu WhatsApp.'); valid = false; }
    if (!email) { setError('lf-email', 'Informe seu e-mail.'); valid = false; }
    else if (!isValidEmail(email)) { setError('lf-email', 'E-mail inválido.'); valid = false; }

    if (!valid) {
      var first = form.querySelector('.field-error');
      if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }

    var text = 'Olá Mclair! Me chamo ' + nome + ', do leiloeiro ' + empresa
      + '.\n\n*Principal desafio hoje:* ' + desafio
      + '\n\n*E-mail:* ' + email
      + '\n\n*WhatsApp:* ' + whats;
    window.open('https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text), '_blank');
  });
})();
</script>

<script is:inline define:vars={{ CASES_BG_VIDEO_ID }}>
(function () {
  // Vídeo de fundo da seção de cases — carrega só quando a seção entra na tela
  var wrap = document.getElementById('lh-cases-video-wrap');
  if (wrap) {
    var loaded = false;
    function loadCasesVideo() {
      if (loaded) return;
      loaded = true;
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube.com/embed/' + CASES_BG_VIDEO_ID
        + '?autoplay=1&mute=1&loop=1&playlist=' + CASES_BG_VIDEO_ID
        + '&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1&iv_load_policy=3';
      iframe.title = '';
      iframe.frameBorder = '0';
      iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:max(100%,calc(100vh * 1.778));height:max(100%,calc(100vw * 0.5625));min-width:100%;min-height:100%;pointer-events:none;opacity:0;transition:opacity 1.2s ease;border:0;';
      wrap.insertBefore(iframe, wrap.firstChild);
      // Espera o player estabilizar (esconde o card de título/marca do YouTube) antes de revelar
      setTimeout(function () { iframe.style.opacity = '.24'; }, 2200);
    }
    if ('IntersectionObserver' in window) {
      var vidObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { loadCasesVideo(); vidObs.disconnect(); }
        });
      }, { rootMargin: '400px' });
      vidObs.observe(wrap);
    } else {
      loadCasesVideo();
    }
  }

  // Modal de case
  var modal = document.getElementById('lh-case-modal');
  if (modal) {
    var contents = modal.querySelectorAll('[data-case-content]');
    var closeEls = modal.querySelectorAll('[data-modal-close]');
    var triggers = document.querySelectorAll('[data-open-case]');

    function openModal(slug) {
      contents.forEach(function (el) {
        el.classList.toggle('is-active', el.getAttribute('data-case-content') === slug);
      });
      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }
    triggers.forEach(function (btn) {
      btn.addEventListener('click', function () { openModal(btn.getAttribute('data-open-case')); });
    });
    closeEls.forEach(function (el) { el.addEventListener('click', closeModal); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });
  }
})();
</script>

