---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { getCases } from '../utils/cmsApi';

const allCases = await getCases();
const fidalgoCase = allCases.find((c) => c.slug === 'fidalgo');
const globoCase = allCases.find((c) => c.slug === 'globo-leiloes');
const vipCase = allCases.find((c) => c.slug === 'vip-leiloes');

const CASES_BG_VIDEO_ID = 'ZsbxCdWN-7Q';

const WA_NUMBER = '5511988600372';
const WA_TEXT = 'Olá! Vim pela página da Mclair e quero entender como vocês podem aumentar as disputas por lance no meu leilão.';
const WA = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_TEXT)}`;

const logos = [
  { name: 'Fidalgo Leilões', logo: '/clientes/fidalgo-leiloes-logo.webp', slug: 'fidalgo' },
  { name: 'Globo Leilões',   logo: '/clientes/globo-leiloes-logo.webp',   slug: 'globo-leiloes' },
  { name: 'VIP Leilões',     logo: '/clientes/vip-leiloes-logo.webp',     slug: 'vip-leiloes' },
  { name: 'Ribeiro Leilões', logo: '/clientes/ribeiro-leiloes-logo.webp', slug: null },
  { name: 'Balbino Leilões', logo: '/clientes/balbino-leiloes-logo.webp', slug: null },
];

const bigNumbers = [
  { v: '3.000+', label: 'Inserções na mídia em veículos como Valor, Globo, G1, Folha, CNN, Extra, Band, SBT, A Tarde e O Povo' },
  { v: '5,7 milhões', label: 'Visualizações geradas em redes sociais' },
  { v: '+31 milhões', label: 'Cliques gerados para o site do leiloeiro' },
  { v: 'R$ 157 milhões', label: 'Um imóvel da carteira vendido, após 4 tentativas frustradas de outras empresas' },
];

const servicos = [
  {
    title: 'Assessoria de imprensa especializada',
    desc: 'Pauta e relacionamento direto com jornalistas e veículos que cobrem o mercado de leilões.',
  },
  {
    title: 'Redes sociais',
    desc: 'Conteúdo que educa, aquece a base e aumenta o engajamento antes de cada praça.',
  },
  {
    title: 'Growth e performance',
    desc: 'Campanhas em Google, Meta e YouTube com foco em geração de lead qualificado, não só alcance.',
  },
  {
    title: 'E-mail marketing e inbound',
    desc: 'Nutrição da sua base para que ela chegue aquecida em cada novo leilão.',
  },
  {
    title: 'Branding e reposicionamento',
    desc: 'Para leiloeiros que precisam de uma marca à altura do resultado que já entregam.',
  },
];

const cardImages: Record<string, string> = {
  fidalgo: '/cases-img/fidalgo-press-1.webp',
  'globo-leiloes': '/cases-img/globo-leiloes-1.webp',
  'vip-leiloes': '/cases-img/vip-leiloes-5.webp',
};

const cases = ([
  { slug: 'fidalgo', data: fidalgoCase },
  { slug: 'globo-leiloes', data: globoCase },
  { slug: 'vip-leiloes', data: vipCase },
] as any[]).map(({ slug, data }) => ({
  slug,
  client: data.client as string,
  accent: data.accent as string,
  sector: data.sector as string,
  img: cardImages[slug],
  challenge: data.challenge as string,
  solution: data.solution as string,
  results: data.results as { v: string; l: string }[],
  tags: data.tags as string[],
}));

const faqs = [
  {
    q: 'Já invisto em tráfego pago. Preciso de assessoria de imprensa também?',
    a: 'Sim, e são complementares. Tráfego pago alcança quem já está navegando. Assessoria de imprensa alcança quem ainda está decidindo em quem confiar. Juntas, aumentam tanto o alcance quanto a taxa de conversão em lance.',
  },
  {
    q: 'Quanto tempo até ver resultado?',
    a: 'Os primeiros movimentos aparecem já nas primeiras semanas, com pauta ativa e presença em veículos do setor. Resultados consistentes de autoridade e recorrência de imprensa costumam se consolidar em poucos meses, como mostram os cases de Fidalgo, Vip e Globo Leilões.',
  },
  {
    q: 'A Mclair atende só leilões da Caixa?',
    a: 'Não. Atendemos leilões judiciais, extrajudiciais, de alienação fiduciária e parcerias com instituições financeiras como Caixa, Bradesco, Itaú, Santander, Correios e TRT.',
  },
  {
    q: 'Como funciona o primeiro contato?',
    a: 'Você preenche o formulário abaixo ou chama no WhatsApp. Entendemos o momento do seu leilão e propomos o formato de atuação mais adequado.',
  },
];

const desafios = [
  'Pouca visibilidade na mídia',
  'Poucos lances por leilão',
  'Dependência só de tráfego pago',
  'Quero reposicionar minha marca',
];
---

<Layout
  title="Marketing para Leiloeiros | Mclair Assessoria de Imprensa e Growth"
  description="Comunicação especializada para o mercado de leilões: assessoria de imprensa, growth e conteúdo que transformam visibilidade em arrematantes reais. Cases: Fidalgo, Globo e VIP Leilões."
  keywords="assessoria de imprensa para leiloeiros, marketing para leilões, comunicação para leiloeiros, mclair leilões, growth para leilões"
  ogImage="https://mclair.com.br/paginas/marketing-para-leiloeiros-mclair.webp"
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': 'https://mclair.com.br/marketing-para-leiloeiros#webpage',
      name: 'Marketing para Leiloeiros: Assessoria de Imprensa e Growth para Leilões, por Mclair',
      description: 'Comunicação especializada para o mercado de leilões: assessoria de imprensa, growth e conteúdo que transformam visibilidade em arrematantes reais.',
      url: 'https://mclair.com.br/marketing-para-leiloeiros',
      isPartOf: { '@id': 'https://mclair.com.br/#website' },
      about: { '@id': 'https://mclair.com.br/#organization' },
      inLanguage: 'pt-BR',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lh-title', '.section-title'] },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://mclair.com.br' },
        { '@type': 'ListItem', position: 2, name: 'Leiloeiros', item: 'https://mclair.com.br/marketing-para-leiloeiros' },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'Comunicação Estratégica para Leiloeiros',
      provider: { '@id': 'https://mclair.com.br/#organization' },
      areaServed: { '@type': 'Country', name: 'Brasil' },
      description: 'Assessoria de imprensa, growth e conteúdo especializados no mercado de leilões, para leiloeiros que querem transformar visibilidade em arrematantes reais.',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="lh-hero">
  <div class="lh-hero-photo" aria-hidden="true">
    <img src="/paginas/marketing-para-leiloeiros-mclair.webp" alt="" />
  </div>
  <div class="lh-hero-bg" aria-hidden="true">
    <div class="lh-grid"></div>
    <div class="lh-blob lh-blob-1"></div>
    <div class="lh-blob lh-blob-2"></div>
  </div>
  <div class="container lh-hero-inner">
    <p class="eyebrow eyebrow-light hero-instant" data-anim style="justify-content:flex-start">
      Marketing para Leiloeiros · por Mclair
    </p>
    <h1 class="lh-title hero-instant" data-anim data-delay="1">
      Seu leilão merece<br/>
      mais que curtidas.<br/>
      Merece <em>disputa por lance.</em>
    </h1>
    <p class="lh-sub hero-instant" data-anim data-delay="2">
      A Mclair é especialista em comunicação para o mercado de leilões. Unimos assessoria de imprensa, growth e conteúdo para transformar visibilidade em arrematantes reais.
    </p>
    <div class="lh-actions hero-instant" data-anim data-delay="3">
      <a href="#form" class="btn-primary">
        Quero atrair mais arrematantes
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href={WA} class="btn-hero-ghost" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Falar agora no WhatsApp
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════ LOGOS ═══════════════ -->
<section class="lh-logos-strip">
  <p class="lh-logos-label container" data-anim>Leiloeiros que confiam na Mclair para chegar até quem está pronto para dar lance</p>
  <div class="lh-logos-marquee" data-anim data-delay="1">
    <div class="lh-logos-track">
      {[...logos, ...logos].map((l, i) => {
        const Tag = l.slug ? 'a' : 'div';
        const linkProps = l.slug ? { href: `/cases/${l.slug}/` } : {};
        return (
          <Tag class="lh-logo-item" aria-hidden={i >= logos.length ? 'true' : undefined} tabindex={i >= logos.length ? -1 : undefined} {...linkProps}>
            <img src={l.logo} alt={l.name} title={l.name} loading="lazy" />
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<!-- ═══════════════ BIG NUMBERS ═══════════════ -->
<section class="section lh-numbers-section">
  <div class="container">
    <div style="text-align:center;max-width:640px;margin:0 auto 56px">
      <p class="eyebrow" data-anim style="justify-content:center">Resultado, não achismo</p>
      <h2 class="section-title" data-anim data-delay="1" style="margin-top:14px">
        Resultado que aparece no seu <span>extrato</span>, não só no seu feed
      </h2>
    </div>
    <div class="lh-numbers-grid stagger-children" data-anim data-delay="1">
      {bigNumbers.map(n => (
        <div class="lh-number-card">
          <strong class="lh-number-val">{n.v}</strong>
          <span class="lh-number-label">{n.label}</span>
        </div>
      ))}
    </div>
    <p class="lh-numbers-close" data-anim data-delay="2">Números que vêm de estratégia, não de sorte.</p>
  </div>
</section>

<!-- ═══════════════ DIFERENCIAL ═══════════════ -->
<section class="lh-diff-section">
  <div class="container lh-diff-grid">
    <div class="lh-diff-video-wrap" data-anim="left" data-hover-video data-video-id="OgcjD1P_JfQ">
      <img src="https://i.ytimg.com/vi/OgcjD1P_JfQ/hqdefault.jpg" alt="" loading="lazy" class="lh-diff-video-thumb" />
      <div class="lh-diff-video-play" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </div>
    </div>
    <div data-anim="right" data-delay="1">
      <p class="eyebrow" data-anim style="justify-content:flex-start">O diferencial</p>
      <h2 class="section-title" data-anim data-delay="1" style="margin-top:14px">
        Tráfego pago traz clique.<br/>Assessoria de imprensa traz <span>autoridade.</span>
      </h2>
      <p class="lh-diff-text" style="margin-top:24px">
        Você já deve ter sentido isso: investe em impulsionamento, o alcance sobe, mas o número de lances não acompanha. Isso acontece porque quem decide arrematar não se convence só com anúncio. Se convence com autoridade.
      </p>
      <p class="lh-diff-text">
        Quando o seu leilão aparece nos veículos que o seu público já confia, você não está comprando atenção. Está construindo credibilidade. E é credibilidade que faz um comprador em dúvida se cadastrar e dar o primeiro lance.
      </p>
      <p class="lh-diff-text">
        A Mclair trabalha há anos dentro do mercado de leilões. Conhece o que motiva um editor a publicar, o que faz um arrematante confiar e o que faz um leilão virar notícia recorrente, não só um post patrocinado.
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-hover-video]').forEach((wrap) => {
    const videoId = wrap.getAttribute('data-video-id');
    let iframe: HTMLIFrameElement | null = null;

    wrap.addEventListener('mouseenter', () => {
      if (iframe) return;
      const rect = wrap.getBoundingClientRect();
      iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&modestbranding=1&playsinline=1&rel=0&iv_load_policy=3`;
      iframe.title = '';
      iframe.frameBorder = '0';
      iframe.width = String(Math.round(rect.width));
      iframe.height = String(Math.round(rect.height));
      iframe.allow = 'autoplay; encrypted-media; playsinline';
      iframe.className = 'lh-diff-video-iframe';
      wrap.appendChild(iframe);
      wrap.classList.add('is-playing');
    });

    wrap.addEventListener('mouseleave', () => {
      if (!iframe) return;
      iframe.remove();
      iframe = null;
      wrap.classList.remove('is-playing');
    });
  });
</script>

<!-- ═══════════════ O QUE FAZEMOS ═══════════════ -->
<section class="section lh-servicos-section">
  <div class="container">
    <div style="text-align:center;max-width:640px;margin:0 auto 56px">
      <p class="eyebrow" data-anim style="justify-content:center">O que fazemos por você</p>
      <h2 class="section-title" data-anim data-delay="1" style="margin-top:14px">
        Comunicação completa para o seu leilão, do <span>primeiro clique</span> ao lance vencedor
      </h2>
    </div>
    <div class="lh-servicos-grid stagger-children" data-anim data-delay="1">
      {servicos.map((s) => (
        <div class="lh-servico-card">
          <h3 class="lh-servico-title">{s.title}</h3>
          <p class="lh-servico-desc">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════ CASES EM DESTAQUE ═══════════════ -->
<section class="lh-cases-section">
  <div class="lh-cases-video-wrap" aria-hidden="true" id="lh-cases-video-wrap">
    <div class="lh-cases-video-overlay"></div>
  </div>
  <div class="container lh-cases-container">
    <div style="text-align:center;max-width:640px;margin:0 auto 56px">
      <p class="eyebrow eyebrow-light" data-anim style="justify-content:center">Prova, não promessa</p>
      <h2 class="section-title" data-anim data-delay="1" style="margin-top:14px;color:#fff">
        Resultados que já aconteceram com leiloeiros como você
      </h2>
    </div>
    <div class="lh-cases-grid stagger-children" data-anim data-delay="1">
      {cases.map(c => (
        <button type="button" class="lh-case-card" data-open-case={c.slug} style={`--accent:${c.accent}`}>
          <div class="lh-case-img-wrap">
            <img src={c.img} alt={c.client} loading="lazy" class="lh-case-img" />
          </div>
          <div class="lh-case-body">
            <h3 class="lh-case-client">{c.client}</h3>
            <span class="lh-case-tag" style={`color:${c.accent}`}>{c.sector}</span>
            <strong class="lh-case-result" style={`color:${c.accent}`}>{c.results[0].v}</strong>
            <span class="lh-case-label">{c.results[0].l}</span>
            <div class="lh-case-mini-stats">
              {c.results.slice(1, 3).map(s => (
                <div class="lh-case-mini-stat">
                  <strong>{s.v}</strong>
                  <span>{s.l}</span>
                </div>
              ))}
            </div>
            <span class="lh-case-cta">
              Ver resultados
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </span>
          </div>
        </button>
      ))}
    </div>
    <div class="lh-cases-all-link-wrap">
      <a href="/cases/" class="btn-text lh-cases-all-link">
        Ver todos os cases de clientes
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- ═══════════════ MODAL DE CASE ═══════════════ -->
<div id="lh-case-modal" class="lh-modal" role="dialog" aria-modal="true" aria-label="Detalhes do case">
  <div class="lh-modal-backdrop" data-modal-close></div>
  <div class="lh-modal-panel">
    <button class="lh-modal-close" data-modal-close aria-label="Fechar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
    {cases.map(c => (
      <div class="lh-modal-content" data-case-content={c.slug} style={`--accent:${c.accent}`}>
        <span class="lh-modal-tag" style={`color:${c.accent};border-color:${c.accent}40`}>{c.sector}</span>
        <h3 class="lh-modal-client">{c.client}</h3>
        <div class="lh-modal-grid">
          <div>
            <h4>O desafio</h4>
            <p>{c.challenge}</p>
          </div>
          <div>
            <h4>A solução Mclair</h4>
            <p>{c.solution}</p>
          </div>
        </div>
        <div class="lh-modal-results">
          {c.results.map(r => (
            <div class="lh-modal-result">
              <strong style={`color:${c.accent}`}>{r.v}</strong>
              <span>{r.l}</span>
            </div>
          ))}
        </div>
        <div class="lh-modal-tags">
          {c.tags.map(t => <span class="lh-modal-tag-pill">{t}</span>)}
        </div>
        <a href={`/cases/${c.slug}/`} class="btn-outline lh-modal-link">
          Ver case completo na página
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>
    ))}
  </div>
</div>

<!-- ═══════════════ FAQ ═══════════════ -->
<section class="section faq-section">
  <div class="container">
    <div class="faq-header" data-anim>
      <p class="eyebrow" style="justify-content:center">Antes de falar com a gente</p>
      <h2 class="section-title" style="margin-top:14px;text-align:center">
        Perguntas frequentes de <span>leiloeiros</span>
      </h2>
    </div>
    <div class="faq-list">
      {faqs.map((f, i) => (
        <div class="faq-item" data-anim data-delay={(i % 2 + 1).toString()}>
          <h3 class="faq-q">{f.q}</h3>
          <p class="faq-a">{f.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════ CTA FINAL ═══════════════ -->
<section class="lh-cta-final">
  <div class="container lh-cta-final-inner">
    <div>
      <h2 class="lh-cta-title" data-anim>Pronto para transformar visibilidade em lance?</h2>
      <p class="lh-cta-sub" data-anim data-delay="1">
        Fale com quem já colocou leiloeiros nos principais veículos do país e ajudou a construir o resultado comercial que aparece no extrato, não só no relatório de alcance.
      </p>
    </div>
    <div data-anim="right" data-delay="1">
      <a href="#form" class="btn-white">
        Quero minha proposta
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <span class="lh-cta-support">Resposta em até 2 horas úteis</span>
    </div>
  </div>
</section>

<!-- ═══════════════ FORMULÁRIO ═══════════════ -->
<section class="section lh-form-section" id="form">
  <div class="container lh-form-wrap">
    <div class="lh-form-intro" data-anim="left">
      <p class="eyebrow" data-anim style="justify-content:flex-start">Vamos falar sobre o seu leilão</p>
      <h2 class="section-title" data-anim data-delay="1" style="margin-top:14px">
        Conte seu momento.<br/>A gente propõe o caminho.
      </h2>
      <p class="section-lead" data-anim data-delay="2">
        Preencha o formulário e entraremos em contato em até 2 horas úteis, ou chame direto no WhatsApp.
      </p>
      <a href={WA} class="btn-outline" target="_blank" rel="noopener" data-anim data-delay="3" style="margin-top:24px">
        Falar no WhatsApp agora
      </a>
    </div>

    <form class="contact-form lh-form" id="leiloes-form" novalidate data-anim="right" data-delay="1">
      <div class="form-row">
        <div class="field">
          <label for="lf-nome">Nome *</label>
          <input type="text" id="lf-nome" name="nome" placeholder="Seu nome completo" required />
        </div>
        <div class="field">
