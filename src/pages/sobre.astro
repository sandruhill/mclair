---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import sobreJson from '../content/singletons/sobre.json';

const WA = 'https://wa.me/5511988600372?text=Olá%20Mclair!%20Gostaria%20de%20falar%20com%20a%20equipe.';

const sobreContent = (sobreJson as any).content;
const valores  = (sobreContent?.valores  ?? []) as any[];
const equipe   = (sobreContent?.equipe   ?? []) as any[];
const seo = sobreContent?.seo ?? {};
---

<Layout
  title={seo.title || 'Sobre a Mclair | Comunicação Estratégica desde 2017'}
  description={seo.description || 'Agência fundada em 2017 por Kelly Pinheiro. 200+ clientes, 23+ segmentos, 11.600+ inserções na mídia e 1.734 publicações internacionais.'}
  ogImage={seo.ogImage || 'https://olive-gnat-658393.hostingersite.com/sobre/equipe-mclair-comunicacao-estrategica.jpg'}
  keywords={seo.keywords}
  keywords="agência comunicação estratégica, marketing de autoridade São Paulo, assessoria de imprensa, Kelly Pinheiro, Mclair agência, história Mclair, equipe Mclair, agência 2017"
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      '@id': 'https://olive-gnat-658393.hostingersite.com/sobre#page',
      name: 'Sobre a Mclair: Comunicação Estratégica desde 2017',
      description: 'Conheça a Mclair: fundada em 2017 por Kelly Pinheiro, especializada em Comunicação Estratégica e Marketing de Autoridade. 200+ clientes, 23+ segmentos, 11.600+ inserções na mídia.',
      url: 'https://olive-gnat-658393.hostingersite.com/sobre',
      mainEntity: { '@id': 'https://olive-gnat-658393.hostingersite.com/#organization' },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://olive-gnat-658393.hostingersite.com' },
          { '@type': 'ListItem', position: 2, name: 'Sobre', item: 'https://olive-gnat-658393.hostingersite.com/sobre' },
        ],
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': 'https://olive-gnat-658393.hostingersite.com/sobre#kelly',
      name: 'Kelly Pinheiro',
      jobTitle: 'CEO & Sócio-Fundadora',
      worksFor: { '@id': 'https://olive-gnat-658393.hostingersite.com/#organization' },
      description: 'CEO & Sócio-Fundadora da Mclair. Especialista em Comunicação Estratégica e Marketing de Autoridade com mais de 20 anos de experiência.',
      sameAs: ['https://instagram.com/mclair.com.br', 'https://linkedin.com/company/mclair-comunicacao'],
      knowsAbout: ['Marketing de Autoridade', 'Comunicação Estratégica', 'Assessoria de Imprensa', 'Branding', 'Marca Pessoal'],
    },
  ]}
>

<!-- HERO -->
<section class="page-hero">
  <div class="ph-photo-bg" aria-hidden="true">
    <img src="/paginas/sobre-estrategia-comunicacao-mclair.jpg" alt="Sobre a Mclair: Agência de Comunicação Estratégica e Marketing de Autoridade em São Paulo" title="Sobre a Mclair: estratégia, comunicação e resultados desde 2017" class="ph-photo-img" />
    <div class="ph-photo-overlay"></div>
  </div>
  <div class="ph-bg" aria-hidden="true">
    <div class="ph-blob-1"></div>
  </div>
  <div class="container ph-inner">
    <p class="eyebrow" data-anim style="color:rgba(255,255,255,.5)">
      Quem somos
    </p>
    <h1 class="ph-title" data-anim data-delay="1">
      Mclair: Comunicação Estratégica<br/>
      <em>e Marketing de Autoridade desde 2017</em>
    </h1>
    <p class="ph-sub" data-anim data-delay="2">
      Fundada em 2017 por Kelly Pinheiro em São Paulo. Atende 23+ segmentos, de executivos a multinacionais, com equipes de Assessoria de Imprensa, Branding e Marketing Digital. 200+ clientes, 11.600+ inserções na mídia.
    </p>
    <div class="ph-stats stagger-children" data-delay="3">
      <div class="phs-item">
        <strong class="counter" data-target="9" data-suffix="+">0</strong>
        <span>Anos de mercado</span>
      </div>
      <div class="phs-sep"></div>
      <div class="phs-item">
        <strong class="counter" data-target="200" data-suffix="+">0</strong>
        <span>Clientes atendidos</span>
      </div>
      <div class="phs-sep"></div>
      <div class="phs-item">
        <strong class="counter" data-target="11600" data-suffix="+">0</strong>
        <span>Inserções na mídia</span>
      </div>
      <div class="phs-sep"></div>
      <div class="phs-item">
        <strong class="counter" data-target="1734" data-suffix="+">0</strong>
        <span>Publicações internacionais</span>
      </div>
    </div>
  </div>
</section>

<!-- PURPOSE -->
<section class="section purpose-section">
  <div class="container purpose-grid">
    <div data-anim="left">
      <p class="eyebrow">Nosso propósito</p>
      <h2 class="section-title" style="margin-top:14px">
        Construir legados através da<br/><span>Comunicação com Propósito</span>
      </h2>
      <p class="section-lead" style="margin-top:16px">
        Em 9 anos de atuação, a Mclair construiu mais de 11.600 inserções na mídia nacional e 1.734 publicações internacionais para seus clientes. Cada projeto começa com um diagnóstico profundo da marca e termina com métricas claras, porque autoridade real precisa ser medida.
      </p>
      <p class="section-lead" style="margin-top:12px">
        Somos formados por jornalistas, estrategistas de marca e especialistas em performance digital. Nossa abordagem integrada cobre Marketing de Autoridade, Assessoria de Imprensa, Branding Estratégico e Marketing Digital, sempre com transparência total em relatórios e KPIs.
      </p>
      <div class="purpose-actions" style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap">
        <a href="#valores" class="btn-primary">Conheça Nossos Valores</a>
        <a href={WA} class="btn-outline" target="_blank" rel="noopener">Fale com a Equipe</a>
      </div>
    </div>
    <div class="purpose-pillars stagger-children" data-anim="right">
      <div class="pp-item">
        <span class="pp-dot"></span>
        <div>
          <h3>Comunicação Estratégica</h3>
          <p>Toda mensagem planejada com dados e propósito claro</p>
        </div>
      </div>
      <div class="pp-item">
        <span class="pp-dot pp-dot-teal"></span>
        <div>
          <h3>Marketing de Autoridade</h3>
          <p>Construindo referências reconhecidas no mercado</p>
        </div>
      </div>
      <div class="pp-item">
        <span class="pp-dot pp-dot-orange"></span>
        <div>
          <h3>Resultados Duradouros</h3>
          <p>Estratégias que permanecem, não apenas imediatas</p>
        </div>
      </div>
      <div class="pp-item">
        <span class="pp-dot"></span>
        <div>
          <h3>Transparência Total</h3>
          <p>KPIs claros, relatórios honestos, evolução contínua</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VALORES -->
<section class="section valores-section" id="valores">
  <div class="container">
    <div class="section-header-center" data-anim>
      <p class="eyebrow" style="justify-content:center">Nossos valores</p>
      <h2 class="section-title" style="margin-top:14px">O que nos move todo dia</h2>
    </div>
    <div class="valores-grid stagger-children">
      {valores.map(v => (
        <div class="valor-card">
          <span class="vc-icon" set:html={v.icon}></span>
          <h3 class="vc-title">{v.title}</h3>
          <p class="vc-desc">{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- LIDERANÇA -->
<section class="section equipe-section">
  <div class="container">
    <div class="section-header-center" data-anim>
      <p class="eyebrow" style="justify-content:center">Liderança</p>
      <h2 class="section-title" style="margin-top:14px">A frente da <span>Mclair</span></h2>
    </div>
    <div class="equipe-grid stagger-children">
      {equipe.map((m) => (
        <div class="membro-card">
          <div class="mc-avatar" style="background:var(--red)">
            {m.initials}
          </div>
          <h3 class="mc-nome">{m.nome}</h3>
          <span class="mc-cargo">{m.cargo}</span>
          <p class="mc-bio">{m.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

</Layout>

<style>
/* HERO */
.page-hero {
  background:var(--dark); min-height:80vh;
  display:flex; align-items:center;
  position:relative; overflow:hidden;
  padding-top:78px;
}
.ph-photo-bg { position:absolute; inset:0; z-index:0; }
.ph-photo-img { width:100%; height:100%; object-fit:cover; object-position:center 30%; }
.ph-photo-overlay { position:absolute; inset:0; background:linear-gradient(135deg,rgba(21,18,16,.88) 0%,rgba(21,18,16,.7) 100%); }
.ph-bg { position:absolute; inset:0; pointer-events:none; z-index:1; }
.ph-blob-1 {
  position:absolute; width:600px;height:600px;
  border-radius:50%; filter:blur(100px);
  right:-100px; top:-100px;
  background:radial-gradient(circle,rgba(200,16,46,.12) 0%,transparent 70%);
}
.ph-inner { padding-top:72px; padding-bottom:72px; max-width:860px; position:relative; z-index:2; }
.ph-title {
  font-size:clamp(2.4rem,5vw,4.4rem); font-weight:900;
  letter-spacing:-.03em; line-height:1.08; color:#fff; margin:18px 0 22px;
}
.ph-title em { font-weight:300; font-style:italic; color:rgba(255,255,255,.5); }
.ph-sub { font-size:1rem; font-weight:300; color:rgba(255,255,255,.75); line-height:1.85; max-width:600px; }
.ph-stats { display:flex; align-items:center; gap:36px; flex-wrap:nowrap; margin-top:52px; }
.phs-item { text-align:left; flex-shrink:1; min-width:0; }
.phs-item strong { display:block; font-size:clamp(1.8rem,3.5vw,2.8rem); font-weight:900; color:var(--red); line-height:1; white-space:nowrap; }
.phs-item span { font-size:.65rem; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.3); display:block; margin-top:6px; }
.phs-sep { width:1px; height:48px; background:rgba(255,255,255,.08); flex-shrink:0; }

/* PURPOSE */
.purpose-section { background:#fff; }
.purpose-grid { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }
.purpose-pillars { display:flex; flex-direction:column; gap:0; }
.pp-item {
  display:flex; align-items:flex-start; gap:18px;
  padding:20px 0; border-bottom:1px solid var(--line);
}
.pp-item:first-child { border-top:1px solid var(--line); }
.pp-dot {
  display:inline-block; width:9px; height:9px; border-radius:50%;
  background:var(--red); flex-shrink:0; margin-top:4px;
  animation:pp-pulse 2.2s ease-in-out infinite;
  box-shadow:0 0 0 0 rgba(200,16,46,.5);
}
.pp-dot-teal { background:var(--teal); animation:pp-pulse-teal 2.2s ease-in-out infinite; }
.pp-dot-orange { background:var(--orange); animation:pp-pulse-orange 2.2s ease-in-out infinite; }
@keyframes pp-pulse { 0%,100%{box-shadow:0 0 0 0 rgba(200,16,46,.5)} 50%{box-shadow:0 0 0 6px rgba(200,16,46,0)} }
@keyframes pp-pulse-teal { 0%,100%{box-shadow:0 0 0 0 rgba(27,138,118,.5)} 50%{box-shadow:0 0 0 6px rgba(27,138,118,0)} }
@keyframes pp-pulse-orange { 0%,100%{box-shadow:0 0 0 0 rgba(212,97,27,.5)} 50%{box-shadow:0 0 0 6px rgba(212,97,27,0)} }
.pp-item h3 { font-size:.92rem; font-weight:700; color:var(--ink); margin-bottom:4px; }
.pp-item p { font-size:.95rem; color:var(--ink-3); font-weight:300; line-height:1.6; }

/* VALORES */
.valores-section { background:#fff; }
.section-header-center { text-align:center; max-width:520px; margin:0 auto 56px; }
.valores-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:2px; }
.valor-card {
  padding:36px 28px; background:var(--cream); border:1px solid var(--line);
  transition:border-color .25s, box-shadow .25s, transform .2s;
}
.valor-card:hover { border-color:var(--red); box-shadow:var(--shadow-md); transform:translateY(-3px); }
.vc-icon {
  color:var(--red); display:block; margin-bottom:18px;
  width:26px; height:26px;
  transition:transform .25s cubic-bezier(.22,1,.36,1);
}
.vc-icon svg { width:100%; height:100%; stroke:currentColor; }
.valor-card:hover .vc-icon { transform:scale(1.15); }
.vc-title { font-size:.95rem; font-weight:700; color:var(--ink); margin-bottom:10px; }
.vc-desc { font-size:.95rem; color:var(--ink-3); line-height:1.8; font-weight:300; }

/* EQUIPE */
.equipe-section { background:var(--cream-2); }
.equipe-grid { display:flex; justify-content:center; gap:20px; }
.membro-card {
  background:#fff; border:1px solid var(--line); border-radius:var(--r-lg);
  padding:32px 24px; text-align:center; max-width:340px;
  display:flex; flex-direction:column; align-items:center;
  transition:box-shadow .25s, transform .2s, border-color .2s;
}
.membro-card:hover { box-shadow:var(--shadow-md); transform:translateY(-4px); border-color:var(--red); }
.mc-avatar {
  width:70px; height:70px; border-radius:50%; color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:1.2rem; font-weight:700; margin-bottom:18px;
}
.mc-nome { font-size:.98rem; font-weight:700; color:var(--ink); margin-bottom:5px; }
.mc-cargo { font-size:.65rem; letter-spacing:.1em; text-transform:uppercase; color:var(--red); margin-bottom:14px; }
.mc-bio { font-size:.95rem; font-weight:300; color:var(--ink-3); line-height:1.75; }

/* RESPONSIVE */
@media (max-width:1024px) { .valores-grid { grid-template-columns:1fr 1fr; } }
@media (max-width:900px) { .purpose-grid { grid-template-columns:1fr; gap:48px; } }
@media (max-width:640px) {
  .ph-stats { gap:12px; }
  .phs-item strong { font-size:clamp(1.1rem,4.5vw,1.8rem); }
  .phs-item span { font-size:.52rem; letter-spacing:.06em; }
  .phs-sep { height:28px; }
  .valores-grid { grid-template-columns:1fr; }
}
</style>
