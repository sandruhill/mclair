---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/5511988600372?text=Olá%20Mclair!%20Gostaria%20de%20conhecer%20os%20serviços.';
---

<Layout
  title="Página não encontrada | Mclair"
  description="Essa página não existe ou foi movida. Volte para o início ou fale com a Mclair."
>

<section class="nf-section">
  <div class="container nf-inner">
    <p class="eyebrow" style="justify-content:center">Erro 404</p>
    <h1 class="nf-title">Essa página não existe</h1>
    <p class="nf-sub">O link pode estar quebrado ou a página foi movida. Volte para o início ou fale direto com a gente.</p>
    <div class="nf-actions">
      <a href="/" class="btn-primary">
        Voltar ao início
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href={WA} class="btn-outline" target="_blank" rel="noopener">Falar no WhatsApp</a>
    </div>
    <nav class="nf-links" aria-label="Páginas principais">
      <a href="/sobre">Sobre</a>
      <a href="/servicos">Serviços</a>
      <a href="/cases">Cases</a>
      <a href="/blog">Blog</a>
      <a href="/mentorias">Mentorias</a>
      <a href="/contato">Contato</a>
    </nav>
  </div>
</section>

</Layout>

<style>
.nf-section {
  min-height: 70vh;
  display: flex; align-items: center;
  padding-block: clamp(80px, 12vw, 140px);
  background: var(--cream);
}
.nf-inner { max-width: 640px; margin: 0 auto; text-align: center; }
.nf-title {
  font-size: clamp(2rem, 5vw, 3rem); font-weight: 900;
  letter-spacing: -.03em; color: var(--ink); margin: 16px 0 14px;
  text-wrap: balance;
}
.nf-sub { font-size: 1rem; color: var(--ink-3); line-height: 1.75; max-width: 480px; margin: 0 auto; }
.nf-actions {
  display: flex; align-items: center; justify-content: center; gap: 12px;
  flex-wrap: wrap; margin-top: 32px;
}
.nf-links {
  display: flex; align-items: center; justify-content: center;
  gap: 20px; flex-wrap: wrap; margin-top: 48px;
  padding-top: 32px; border-top: 1px solid var(--line);
}
.nf-links a {
  font-size: .82rem; font-weight: 600; color: var(--ink-3);
  transition: color .2s;
}
.nf-links a:hover { color: var(--red); }
</style>
