---
// /guias/: lista dos guias permanentes de assessoria de imprensa.
// A lista sai de src/components/guias/guias.ts; guia novo aparece aqui sozinho.
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import {
  GUIAS, BASE, URL_GUIAS, URL_HUB_ASSESSORIA, URL_PRECO, URL_KELLY, ID_ORG, ID_KELLY, wa,
} from '../../components/guias/guias';

const URL = `${BASE}${URL_GUIAS}`;
const TITLE = 'Guias de assessoria de imprensa | Mclair';
const DESCRIPTION = 'Guias da Mclair sobre assessoria de imprensa: o que é e o que faz um assessor, como escrever um press release e como aparecer na mídia sem pagar.';
const WA = wa('Olá Mclair! Estava lendo os guias de assessoria de imprensa e quero conversar sobre a minha empresa.');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${URL}#colecao`,
    url: URL,
    name: 'Guias de assessoria de imprensa',
    description: DESCRIPTION,
    inLanguage: 'pt-BR',
    isPartOf: { '@id': `${BASE}/#website` },
    publisher: { '@id': ID_ORG },
    author: { '@id': ID_KELLY },
    mainEntity: { '@id': `${URL}#lista` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${URL}#lista`,
    name: 'Guias de assessoria de imprensa',
    numberOfItems: GUIAS.length,
    itemListElement: GUIAS.map((g, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: g.titulo,
      description: g.resumo,
      url: `${BASE}${g.path}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${BASE}/` },
      { '@type': 'ListItem', position: 2, name: 'Guias', item: URL },
    ],
  },
];
---

<Layout title={TITLE} description={DESCRIPTION} schema={schema}>
<section class="gh-hero">
  <div class="container"><div class="gh-hero-inner">
    <nav class="gh-trilha" aria-label="Você está em">
      <a href="/">Início</a><span aria-hidden="true">/</span><span aria-current="page">Guias</span>
    </nav>
    <h1 class="gh-h1">Guias de assessoria de imprensa</h1>
    <p class="gh-intro">Respostas diretas para as perguntas que mais chegam à Mclair de quem quer levar uma empresa ou um especialista à imprensa. Os guias são escritos por <a href={URL_KELLY}>Kelly Pinheiro</a>, jornalista desde 2004 e fundadora da agência, com exemplos tirados de trabalhos reais.</p>
  </div></div>
</section>

<section class="gh-secao">
  <div class="container"><div class="gh-estreito">
    <ol class="gh-lista">
      {GUIAS.map((g) => (
        <li>
          <h2 class="gh-titulo"><a href={g.path}>{g.titulo}</a></h2>
          <p>{g.resumo}</p>
        </li>
      ))}
    </ol>

    <div class="gh-contratar">
      <h2 class="gh-h2">Prefere que a Mclair faça por você?</h2>
      <p>Os guias mostram o caminho para quem quer tentar sozinho. Se você prefere uma equipe de jornalistas cuidando das pautas, do contato com as redações e da preparação de quem vai falar, veja como funciona a <a href={URL_HUB_ASSESSORIA}>assessoria de imprensa da Mclair</a> e <a href={URL_PRECO}>quanto custa</a>.</p>
      <a href={WA} class="btn-primary" target="_blank" rel="noopener">Falar no WhatsApp</a>
    </div>
  </div></div>
</section>
</Layout>

<style>
.gh-hero { background: var(--dark); padding-top: 88px; }
.gh-hero-inner { padding-block: clamp(44px, 6vw, 80px); max-width: 860px; }
.gh-trilha { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: .9rem; color: rgba(255,255,255,.5); margin-bottom: 18px; }
.gh-trilha a { color: rgba(255,255,255,.65); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.25); }
.gh-h1 { font-size: clamp(2.1rem, 4.6vw, 3.5rem); font-weight: 900; letter-spacing: -.04em; line-height: 1.06; color: #fff; margin-bottom: 22px; text-wrap: balance; }
.gh-intro { font-size: clamp(1.05rem, 1.45vw, 1.2rem); line-height: 1.75; color: rgba(255,255,255,.82); max-width: 700px; text-wrap: pretty; }
.gh-intro a { color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.35); }

.gh-secao { background: #fff; padding-block: clamp(48px, 6vw, 88px); }
.gh-estreito { max-width: 760px; }
.gh-lista { list-style: none; padding: 0; margin: 0; }
.gh-lista li { padding: 24px 0; }
.gh-titulo { font-size: clamp(1.3rem, 2.4vw, 1.7rem); font-weight: 900; letter-spacing: -.025em; line-height: 1.2; margin-bottom: 8px; text-wrap: balance; }
.gh-titulo a { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(200,16,46,.45); }
.gh-titulo a:hover { color: var(--red); text-decoration-color: var(--red); }
.gh-lista p { font-size: 1.04rem; line-height: 1.7; color: var(--ink-3); text-wrap: pretty; }

.gh-contratar { margin-top: clamp(48px, 6vw, 72px); }
.gh-h2 { font-size: clamp(1.45rem, 2.6vw, 2rem); font-weight: 900; letter-spacing: -.03em; line-height: 1.15; color: var(--ink); margin-bottom: 14px; text-wrap: balance; }
.gh-contratar p { font-size: 1.04rem; line-height: 1.75; color: var(--ink-2); margin-bottom: 22px; text-wrap: pretty; }
.gh-contratar p a { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.gh-contratar p a:hover { color: var(--red); }
@media (max-width: 640px) {
  .gh-h1 { font-size: clamp(1.95rem, 8.6vw, 2.5rem); }
  .gh-contratar .btn-primary { width: 100%; justify-content: center; box-sizing: border-box; }
}
</style>
