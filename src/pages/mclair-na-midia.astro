---
// /mclair-na-midia/: matérias conquistadas para clientes, por veículo e por
// cliente. A lista sai dos cases do CMS no build (ver src/utils/midia.ts).
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { getCases } from '../utils/cmsApi';
import { materiasDosCases, porVeiculo, porCliente, type Materia } from '../utils/midia';

const BASE = 'https://mclair.com.br';
const PATH = '/mclair-na-midia/';
const URL = `${BASE}${PATH}`;
const ID_ORG = `${BASE}/#organization`;
const WA = 'https://wa.me/5511988600372?text=Ol%C3%A1%20Mclair!%20Vi%20as%20mat%C3%A9rias%20dos%20clientes%20e%20quero%20levar%20minha%20empresa%20%C3%A0%20imprensa.';

const cases = await getCases();
const materias = materiasDosCases(cases);
const veiculos = porVeiculo(materias);
const clientes = porCliente(materias);

const nMaterias = materias.length;
const nVeiculos = veiculos.length;
const nClientes = clientes.length;
const plural = (n: number, um: string, varios: string) => `${n} ${n === 1 ? um : varios}`;

const TITLE = 'Mclair na mídia: matérias de clientes na imprensa | Mclair';
const DESCRIPTION = `${plural(nMaterias, 'matéria', 'matérias')} conquistadas pela Mclair para clientes em ${plural(nVeiculos, 'veículo', 'veículos')}. Organizadas por veículo e por cliente, com link para cada matéria e para o case.`;

const linkDe = (m: Materia) => (m.externo ? m.href : m.href.startsWith('http') ? m.href : `${BASE}${m.href}`);

// Recortes únicos de cada cliente: uma legenda que cita três veículos vira um
// item só, com os três nomes.
const recortesDoCliente = (ms: Materia[]) => {
  const mapa = new Map<string, { titulo: string; href: string; externo: boolean; veiculos: string[] }>();
  for (const m of ms) {
    const chave = m.externo ? m.href : m.titulo;
    if (!mapa.has(chave)) mapa.set(chave, { titulo: m.titulo, href: m.href, externo: m.externo, veiculos: [] });
    const r = mapa.get(chave)!;
    if (!r.veiculos.includes(m.veiculo)) r.veiculos.push(m.veiculo);
  }
  return [...mapa.values()];
};

const ancora = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${URL}#colecao`,
    url: URL,
    name: 'Mclair na mídia',
    description: DESCRIPTION,
    inLanguage: 'pt-BR',
    isPartOf: { '@id': `${BASE}/#website` },
    publisher: { '@id': ID_ORG },
    about: { '@id': ID_ORG },
    mainEntity: { '@id': `${URL}#materias` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': `${URL}#materias`,
    name: 'Matérias conquistadas pela Mclair para clientes',
    numberOfItems: nMaterias,
    itemListElement: materias.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': m.externo ? 'NewsArticle' : 'CreativeWork',
        name: m.titulo,
        ...(m.externo ? { url: m.href } : { image: linkDe(m) }),
        ...(m.data ? { datePublished: m.data } : {}),
        publisher: { '@type': 'Organization', name: m.veiculo },
        about: { '@type': 'Organization', name: m.cliente },
        isPartOf: { '@id': `${BASE}/cases/${m.caseSlug}/#case` },
        sourceOrganization: { '@id': ID_ORG },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${BASE}/` },
      { '@type': 'ListItem', position: 2, name: 'Mclair na mídia', item: URL },
    ],
  },
];
---

<Layout title={TITLE} description={DESCRIPTION} schema={schema}>
<section class="mm-hero">
  <div class="container"><div class="mm-hero-inner">
    <nav class="mm-trilha" aria-label="Você está em">
      <a href="/">Início</a><span aria-hidden="true">/</span><a href="/cases/">Cases</a><span aria-hidden="true">/</span><span aria-current="page">Mclair na mídia</span>
    </nav>
    <h1 class="mm-h1">Mclair na mídia</h1>
    <p class="mm-intro">Estas são matérias que a Mclair conquistou para os clientes na imprensa. A lista sai dos <a href="/cases/">cases do site</a> e cresce a cada case novo. Cada matéria tem link para o recorte publicado e para o case do cliente.</p>
    <dl class="mm-numeros">
      <div><dt>{nMaterias}</dt><dd>{nMaterias === 1 ? 'matéria' : 'matérias'}</dd></div>
      <div><dt>{nVeiculos}</dt><dd>{nVeiculos === 1 ? 'veículo' : 'veículos'}</dd></div>
      <div><dt>{nClientes}</dt><dd>{nClientes === 1 ? 'cliente' : 'clientes'}</dd></div>
    </dl>
    <nav class="mm-atalhos" aria-label="Formas de ver">
      <a href="#por-veiculo">Ver por veículo</a>
      <a href="#por-cliente">Ver por cliente</a>
    </nav>
  </div></div>
</section>

<section class="mm-secao" id="por-veiculo">
  <div class="container"><div class="mm-estreito">
    <h2 class="mm-h2">Por veículo</h2>
    <p class="mm-p">Os veículos com mais matérias aparecem primeiro.</p>
    {veiculos.map((v) => (
      <div class="mm-grupo" id={`veiculo-${ancora(v.veiculo)}`}>
        <h3 class="mm-h3">{v.veiculo} <span class="mm-conta">{plural(v.materias.length, 'matéria', 'matérias')}</span></h3>
        <ul class="mm-lista">
          {v.materias.map((m) => (
            <li>
              <a href={m.href} class="mm-titulo" target="_blank" rel="noopener">{m.titulo}</a>
              <span class="mm-meta">Cliente: <a href={`/cases/${m.caseSlug}/`}>{m.cliente}</a>{m.data && <>, publicada em {m.data}</>}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div></div>
</section>

<section class="mm-secao mm-secao-cinza" id="por-cliente">
  <div class="container"><div class="mm-estreito">
    <h2 class="mm-h2">Por cliente</h2>
    <p class="mm-p">Cada cliente com os veículos em que saiu e o link para o case completo.</p>
    {clientes.map((c) => (
      <div class="mm-grupo">
        <h3 class="mm-h3"><a href={`/cases/${c.caseSlug}/`}>{c.cliente}</a> <span class="mm-conta">{plural(c.materias.length, 'matéria', 'matérias')} em {plural(c.veiculos.length, 'veículo', 'veículos')}</span></h3>
        <p class="mm-veiculos">{c.veiculos.join(', ')}</p>
        <ul class="mm-lista">
          {recortesDoCliente(c.materias).map((r) => (
            <li>
              <a href={r.href} class="mm-titulo" target="_blank" rel="noopener">{r.titulo}</a>
              <span class="mm-meta">{r.veiculos.join(', ')}</span>
            </li>
          ))}
        </ul>
        <a href={`/cases/${c.caseSlug}/`} class="mm-case">Ver o case {c.cliente}</a>
      </div>
    ))}
  </div></div>
</section>

<section class="mm-fim">
  <div class="container"><div class="mm-estreito">
    <h2 class="mm-h2 mm-claro">Quer sua empresa nessa lista?</h2>
    <p>A Mclair cuida da pauta, do contato com as redações e da preparação de quem vai falar. Veja como funciona a <a href="/servicos/assessoria-de-imprensa/">assessoria de imprensa</a> ou fale com a equipe.</p>
    <a href={WA} class="btn-primary" target="_blank" rel="noopener">Falar no WhatsApp</a>
  </div></div>
</section>
</Layout>

<style>
.mm-hero { background: var(--dark); padding-top: 88px; }
.mm-hero-inner { padding-block: clamp(44px, 6vw, 80px); max-width: 860px; }
.mm-trilha { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: .9rem; color: rgba(255,255,255,.5); margin-bottom: 18px; }
.mm-trilha a { color: rgba(255,255,255,.65); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.25); }
.mm-trilha a:hover { color: #fff; }
.mm-h1 { font-size: clamp(2.1rem, 4.6vw, 3.5rem); font-weight: 900; letter-spacing: -.04em; line-height: 1.06; color: #fff; margin-bottom: 22px; text-wrap: balance; }
.mm-intro { font-size: clamp(1.05rem, 1.45vw, 1.2rem); line-height: 1.75; color: rgba(255,255,255,.82); max-width: 700px; text-wrap: pretty; }
.mm-intro a { color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.35); }
.mm-numeros { display: flex; flex-wrap: wrap; gap: 20px 48px; margin: 36px 0 0; }
.mm-numeros div { margin: 0; }
.mm-numeros dt { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 900; color: #fff; line-height: 1; letter-spacing: -.03em; }
.mm-numeros dd { margin: 6px 0 0; font-size: .95rem; color: rgba(255,255,255,.6); }
.mm-atalhos { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 32px; }
.mm-atalhos a { font-size: .95rem; font-weight: 700; color: #fff; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(255,255,255,.45); }
.mm-atalhos a:hover { text-decoration-color: #fff; }

.mm-secao { background: #fff; padding-block: clamp(48px, 6vw, 88px); }
.mm-secao-cinza { background: #f5f5f4; }
.mm-estreito { max-width: 820px; }
.mm-h2 { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 900; letter-spacing: -.035em; line-height: 1.1; color: var(--ink); margin-bottom: 12px; text-wrap: balance; }
.mm-claro { color: #fff; }
.mm-p { font-size: 1.04rem; line-height: 1.7; color: var(--ink-3); margin-bottom: 8px; text-wrap: pretty; }
.mm-grupo { padding-top: 36px; scroll-margin-top: 96px; }
.mm-h3 { font-size: clamp(1.25rem, 2.2vw, 1.55rem); font-weight: 900; letter-spacing: -.025em; line-height: 1.25; color: var(--ink); margin-bottom: 6px; text-wrap: balance; }
.mm-h3 a { color: inherit; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(200,16,46,.45); }
.mm-h3 a:hover { color: var(--red); text-decoration-color: var(--red); }
.mm-conta { font-size: .9rem; font-weight: 600; letter-spacing: 0; color: var(--ink-4, var(--ink-3)); white-space: nowrap; }
.mm-veiculos { font-size: .98rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 4px; }
.mm-lista { list-style: none; padding: 0; margin: 6px 0 0; }
.mm-lista li { padding: 12px 0; border-bottom: 1px solid var(--line); }
.mm-lista li:last-child { border-bottom: 0; }
.mm-titulo { display: block; font-size: 1.04rem; line-height: 1.55; font-weight: 600; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.35); text-wrap: pretty; }
.mm-titulo:hover { color: var(--red); text-decoration-color: var(--red); }
.mm-meta { display: block; margin-top: 4px; font-size: .92rem; color: var(--ink-3); }
.mm-meta a { color: inherit; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(200,16,46,.35); }
.mm-meta a:hover { color: var(--red); }
.mm-case { display: inline-block; margin-top: 10px; font-size: .95rem; font-weight: 700; color: var(--red); text-decoration: underline; text-underline-offset: 4px; }

.mm-fim { background: var(--dark); padding-block: clamp(56px, 7vw, 96px); }
.mm-fim p { font-size: clamp(1.05rem, 1.4vw, 1.2rem); font-weight: 300; line-height: 1.7; color: rgba(255,255,255,.8); margin-bottom: 30px; text-wrap: pretty; }
.mm-fim p a { color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(255,255,255,.4); }
@media (max-width: 640px) {
  .mm-h1 { font-size: clamp(1.95rem, 8.6vw, 2.5rem); }
  .mm-numeros { gap: 18px 32px; }
  .mm-fim .btn-primary { width: 100%; justify-content: center; box-sizing: border-box; }
}
</style>
