---
// Página pública do autor: blog > autores > autor. Perfil completo no topo
// (Person com @id estável, o mesmo que cada BlogPosting referencia) e todos
// os artigos dele, paginados como as categorias. Autor sem artigo não gera
// página (ver src/utils/blogAuthors.ts).
export const prerender = true;
import Layout from '../../../../layouts/Layout.astro';
import AuthorCard from '../../../../components/AuthorCard.astro';
import type { DbBlogAuthor } from '../../../../utils/cmsApi';
import { descricaoSeo } from '../../../../utils/seoTexto';

export async function getStaticPaths({ paginate }: any) {
  const { getBlogPosts, getBlogAuthors, getBlogPostAuthors, resolveBlogImage } = await import('../../../../utils/cmsApi');
  const { renderizarPost } = await import('../../../../utils/renderPost');
  const { autoresComPosts, autoresDoPost, mapaDeAutores, mapaDeVinculos } = await import('../../../../utils/blogAuthors');

  const [posts, todos, vinculos] = await Promise.all([getBlogPosts(), getBlogAuthors(), getBlogPostAuthors()]);
  const autores = autoresComPosts(todos, posts, vinculos);
  const porId = mapaDeAutores(todos);
  const porPost = mapaDeVinculos(vinculos);

  function ts(d: string) {
    return d ? new Date(d).getTime() : 0;
  }

  return autores.flatMap((autor) => {
    const deste = posts
      .filter((p: any) => autoresDoPost(p, porId, porPost).some((a) => a.id === autor.id))
      .map((p: any) => ({
        slug: p.slug,
        title: p.title,
        subtitle: p.subtitle ?? '',
        date: p.post_date ?? '',
        image: resolveBlogImage(p.featured_image, p.image_url),
        content: renderizarPost(p.content_md),
      }))
      .sort((a: any, b: any) => ts(b.date) - ts(a.date));
    return paginate(deste, { pageSize: 12, params: { autor: autor.slug }, props: { autor } });
  });
}

const { page, autor } = Astro.props as { page: any; autor: DbBlogAuthor };
const BASE = Astro.site ? Astro.site.origin : 'https://mclair.com.br';
const { schemaDoAutor, urlDoAutor, idDoAutor, palavras, paginaDaPessoa } = await import('../../../../utils/blogAuthors');
const perfilUrl = `${BASE}${urlDoAutor(autor.slug)}`;
// Quem tem página própria no site (ex.: /kelly-pinheiro/) ganha o link
// visível aqui; o Person dela já aponta para lá (ver blogAuthors.ts).
const paginaPropria = autor.kind === 'organizacao' ? null : paginaDaPessoa(autor.slug);
const pal = palavras(autor);
const entidade = schemaDoAutor(autor, BASE);
const org = autor.kind === 'organizacao';

function stripHtml(html: string) {
  return html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
}
function excerpt(html: string, len = 110) {
  const text = stripHtml(html);
  return text.length > len ? text.slice(0, len).trimEnd() + '…' : text;
}
function formatDate(d: string) {
  if (!d) return '';
  let dd: string, mm: string, yy: string;
  if (d.includes('-')) {
    [yy, mm, dd] = d.split('-');
  } else {
    [dd, mm, yy] = d.split('/');
  }
  const months = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];
  return `${parseInt(dd)} ${months[parseInt(mm)-1]} ${yy}`;
}
function pageHref(n: number) {
  return n === 1 ? urlDoAutor(autor.slug) : `${urlDoAutor(autor.slug)}${n}/`;
}

// Título e descrição únicos por perfil; a partir da página 2 o título muda
// e a descrição continua a mesma (a página 2 não é uma entidade nova).
const pagina = page.currentPage > 1 ? ` | Página ${page.currentPage}` : '';
const seoTitle = pagina ? pal.tituloPerfil.replace(' | ', `${pagina} | `) : pal.tituloPerfil;
const bioMeta = (autor.bio_short || autor.bio_long || '').replace(/\s+/g, ' ').trim();
const cargoMeta = autor.job_title ? ` ${autor.job_title}.` : '';
const descricao = descricaoSeo(bioMeta
  ? `${autor.name}:${cargoMeta} ${bioMeta}`
  : `${pal.artigosDe} no blog da Mclair.${cargoMeta} ${page.total} artigo${page.total === 1 ? '' : 's'} publicados.`
);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: BASE },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${BASE}/blog` },
    { '@type': 'ListItem', position: 3, name: 'Autores', item: `${BASE}/blog/autores` },
    { '@type': 'ListItem', position: 4, name: autor.name, item: perfilUrl },
  ],
};

const perfilSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${perfilUrl}#profile`,
  url: perfilUrl,
  name: pal.tituloPerfil,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': `${BASE}/#website` },
  // Pessoa: Person completo. Organização: só a referência à Organization
  // que o Layout já declara (mesmo @id, nunca uma segunda).
  mainEntity: entidade,
  hasPart: page.data.map((p: any) => ({
    '@type': 'BlogPosting',
    '@id': `${BASE}/blog/${p.slug}#article`,
    headline: p.title,
    url: `${BASE}/blog/${p.slug}`,
    author: { '@id': idDoAutor(BASE, autor) },
  })),
};
---

<Layout
  title={seoTitle}
  description={descricao}
  ogImage={autor.photo_url ? (autor.photo_url.startsWith('http') ? autor.photo_url : `${BASE}${autor.photo_url}`) : 'https://mclair.com.br/paginas/sobre-estrategia-comunicacao-mclair.jpg'}
  ogImageAlt={autor.name}
  ogType={org ? 'website' : 'profile'}
  prevUrl={page.url.prev || undefined}
  nextUrl={page.url.next || undefined}
  schema={[perfilSchema, breadcrumbSchema]}
>

<section class="ap-hero">
  <div class="container ap-hero-inner">
    <p class="ap-breadcrumb">
      <a href="/blog/">Blog</a>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      <a href="/blog/autores/">Autores</a>
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      <span>{autor.name}</span>
    </p>
  </div>
</section>

<section class="ap-perfil">
  <div class="container ap-perfil-inner">
    <AuthorCard autor={autor} variante="perfil" />
    {autor.topics.length > 0 && (
      <p class="ap-temas">{org ? 'Temas' : 'Escreve sobre'}: {autor.topics.join(', ')}.</p>
    )}
    {paginaPropria && (
      <p class="ap-pagina-propria"><a href={paginaPropria}>Conheça a trajetória de {autor.name}</a></p>
    )}
  </div>
</section>

<section class="section ap-section">
  <div class="container">
    <h2 class="ap-lista-titulo">
      {page.total} artigo{page.total === 1 ? '' : 's'} de {autor.name}{page.currentPage > 1 ? `, página ${page.currentPage}` : ''}
    </h2>

    <div class="ap-grid stagger-children">
      {page.data.map((post: any, i: number) => (
        <article class="blog-card" data-anim data-delay={((i % 3) + 1).toString()}>
          <a href={`/blog/${post.slug}/`} class="bc-link">
            {post.image ? (
              <div class="bc-img-wrap">
                <img src={post.image} alt={post.title} class="bc-img" loading="lazy" onerror="this.parentElement.style.display='none'" />
              </div>
            ) : (
              <div class="bc-img-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".3"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            )}
            <div class="bc-body">
              <div class="bc-meta">
                <time class="bc-date">{formatDate(post.date)}</time>
              </div>
              <h3 class="bc-title">{post.title}</h3>
              {post.subtitle && <p class="bc-subtitle">{post.subtitle}</p>}
              <p class="bc-excerpt">{excerpt(post.content)}</p>
              <span class="bc-read">Ler artigo →</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label={`Páginas dos artigos de ${autor.name}`}>
        {page.url.prev && (
          <a href={page.url.prev} class="pag-btn pag-prev">← Anterior</a>
        )}
        <div class="pag-pages">
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(n => (
            <a
              href={pageHref(n)}
              class={`pag-num ${n === page.currentPage ? 'pag-active' : ''}`}
              aria-current={n === page.currentPage ? 'page' : undefined}
            >
              {n}
            </a>
          ))}
        </div>
        <span class="pag-status">Página {page.currentPage} de {page.lastPage}</span>
        {page.url.next && (
          <a href={page.url.next} class="pag-btn pag-next">Próxima →</a>
        )}
      </nav>
    )}
  </div>
</section>

</Layout>

<style>
.ap-hero { background: var(--dark); padding-top: 112px; padding-bottom: 96px; }
.ap-hero-inner { position: relative; z-index: 1; }
.ap-breadcrumb {
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
  color: rgba(255,255,255,.4);
}
.ap-breadcrumb a { color: rgba(255,255,255,.5); transition: color .2s; }
.ap-breadcrumb a:hover { color: #fff; }

/* O perfil sobe por cima do bloco escuro, como um cartão apoiado no hero. */
.ap-perfil { background: #fff; }
.ap-perfil-inner { max-width: 860px; margin-top: -64px; position: relative; z-index: 2; }
.ap-perfil-inner :global(.autor-card-perfil) { box-shadow: var(--shadow-lg); }
.ap-temas { font-size: .9rem; color: var(--ink-3); margin: 18px 0 0 4px; line-height: 1.6; text-wrap: pretty; }
.ap-pagina-propria { margin: 14px 0 0 4px; }
.ap-pagina-propria a {
  font-size: .9rem; font-weight: 700; color: var(--ink);
  text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-2);
  transition: color .2s, text-decoration-color .2s;
}
.ap-pagina-propria a:hover { color: var(--red); text-decoration-color: var(--red); }

.ap-section { background: #fff; padding-top: 56px; padding-bottom: 96px; }
.ap-lista-titulo { font-size: 1.4rem; font-weight: 900; letter-spacing: -.03em; color: var(--ink); margin-bottom: 32px; text-wrap: balance; }
.ap-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
@media (max-width: 960px) { .ap-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
@media (max-width: 600px) { .ap-grid { grid-template-columns: 1fr; } .ap-perfil-inner { margin-top: -48px; } }

/* Card, same visual language as /blog/ */
.blog-card {
  border-radius: var(--r-lg);
  overflow: hidden;
  border: 1.5px solid var(--line);
  background: #fff;
  transition: box-shadow .3s, transform .3s cubic-bezier(.22,1,.36,1), border-color .25s;
}
.blog-card:hover {
  box-shadow: 0 16px 48px rgba(0,0,0,.1);
  transform: translateY(-4px);
  border-color: rgba(200,16,46,.2);
}
.bc-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
.bc-img-wrap { width: 100%; height: 200px; overflow: hidden; flex-shrink: 0; background: var(--cream); }
.bc-img { width: 100%; height: 100%; object-fit: cover; object-position: center top; transition: transform .5s cubic-bezier(.22,1,.36,1); }
.blog-card:hover .bc-img { transform: scale(1.04); }
.bc-img-placeholder { width: 100%; height: 200px; background: var(--cream); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.bc-body { display: flex; flex-direction: column; padding: 24px 24px 28px; flex: 1; }
.bc-meta { display: flex; align-items: center; gap: 6px; margin-bottom: 12px; }
.bc-date { font-size: .65rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
.bc-title { font-size: 1.05rem; font-weight: 800; line-height: 1.3; letter-spacing: -.02em; color: var(--ink); margin-bottom: 8px; }
.bc-subtitle { font-size: .82rem; font-weight: 600; color: var(--red); line-height: 1.4; margin-bottom: 8px; }
.bc-excerpt { font-size: .82rem; color: var(--ink-3); line-height: 1.65; flex: 1; margin-bottom: 18px; }
.bc-read { font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--red); }

/* Pagination, same as /blog/ */
.pagination { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 72px; flex-wrap: wrap; }
.pag-btn {
  font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink);
  border: 1.5px solid var(--line); border-radius: var(--r-sm); padding: .65rem 1.4rem;
  transition: border-color .2s, color .2s, background .2s; text-decoration: none;
}
.pag-btn:hover { border-color: var(--red); color: var(--red); }
.pag-pages { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
.pag-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px; border-radius: var(--r-sm);
  font-size: .8rem; font-weight: 700; border: 1.5px solid var(--line); color: var(--ink);
  transition: border-color .2s, color .2s, background .2s; text-decoration: none;
}
.pag-num:hover { border-color: var(--red); color: var(--red); }
.pag-active { background: var(--red); color: #fff !important; border-color: var(--red) !important; }
.pag-status { display: none; font-size: .82rem; font-weight: 700; color: var(--ink-2); white-space: nowrap; }
@media (max-width: 600px) {
  .pagination { gap: 14px; }
  .pag-pages { display: none; }
  .pag-status { display: block; }
  .pag-btn { padding: .6rem 1.1rem; font-size: .7rem; }
}
</style>
