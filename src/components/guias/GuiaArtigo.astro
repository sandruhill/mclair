---
// Moldura de cada guia de /guias/: Layout com Article + FAQPage +
// BreadcrumbList, hero com H1 e a resposta direta logo abaixo (o trecho que
// uma IA citaria), assinatura com datas, sumário, corpo (slot), quem escreve,
// FAQ visível, fechamento com WhatsApp e links para os outros guias.
// Os estilos .g-* são globais porque o corpo é escrito na página e não recebe
// o escopo deste componente.
import Layout from '../../layouts/Layout.astro';
import {
  BASE, URL_GUIAS, URL_HUB_ASSESSORIA, URL_PRECO, URL_KELLY, ID_KELLY, ID_ORG,
  PUBLICADO, REVISADO, dataPorExtenso, outrosGuias, GUIAS,
} from './guias';

export interface Pergunta { pergunta: string; resposta: string }

interface Props {
  slug: string;
  title: string;
  description: string;
  keywords: string;
  h1: string;
  /** 2 a 3 frases que respondem a pergunta principal sem rodeio. */
  resposta: string;
  sumario: { id: string; texto: string }[];
  faq: Pergunta[];
  wa: string;
  fimTitulo: string;
  fimTexto: string;
}

const { slug, title, description, keywords, h1, resposta, sumario, faq, wa, fimTitulo, fimTexto } = Astro.props;
const guia = GUIAS.find((g) => g.slug === slug)!;
const URL = `${BASE}${guia.path}`;
const outros = outrosGuias(slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${URL}#article`,
    headline: h1,
    description,
    url: URL,
    mainEntityOfPage: URL,
    inLanguage: 'pt-BR',
    datePublished: PUBLICADO,
    dateModified: REVISADO,
    author: { '@type': 'Person', '@id': ID_KELLY, name: 'Kelly Pinheiro', url: `${BASE}${URL_KELLY}` },
    publisher: { '@id': ID_ORG },
    isPartOf: { '@id': `${BASE}${URL_GUIAS}#colecao` },
    about: guia.donoDe.map((name) => ({ '@type': 'Thing', name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${URL}#faq`,
    mainEntity: faq.map((q) => ({
      '@type': 'Question',
      name: q.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: q.resposta },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${BASE}/` },
      { '@type': 'ListItem', position: 2, name: 'Guias', item: `${BASE}${URL_GUIAS}` },
      { '@type': 'ListItem', position: 3, name: guia.titulo, item: URL },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  ogType="article"
  ogImage={`${BASE}/kelly-pinheiro/kelly-pinheiro-og.jpg`}
  ogImageAlt="Kelly Pinheiro, jornalista e fundadora da Mclair"
  articleAuthor="Kelly Pinheiro"
  articlePublishedTime={PUBLICADO}
  articleModifiedTime={REVISADO}
  articleSection="Guias de assessoria de imprensa"
  schema={schema}
>
<article class="g-artigo">
  <header class="g-hero">
    <div class="container"><div class="g-hero-inner">
      <nav class="g-trilha" aria-label="Você está em">
        <a href="/">Início</a><span aria-hidden="true">/</span>
        <a href={URL_GUIAS}>Guias</a><span aria-hidden="true">/</span>
        <span aria-current="page">{guia.titulo}</span>
      </nav>
      <h1 class="g-h1">{h1}</h1>
      <p class="g-resposta">{resposta}</p>
      <p class="g-assinatura">
        Por <a href={URL_KELLY} rel="author">Kelly Pinheiro</a>, jornalista e fundadora da Mclair.
        <span class="g-datas">Publicado em <time datetime={PUBLICADO}>{dataPorExtenso(PUBLICADO)}</time>. Revisado em <time datetime={REVISADO}>{dataPorExtenso(REVISADO)}</time>.</span>
      </p>
    </div></div>
  </header>

  <div class="container">
    <div class="g-corpo">
      <nav class="g-sumario" aria-labelledby="g-sumario-titulo">
        <p class="g-sumario-titulo" id="g-sumario-titulo">Neste guia</p>
        <ol>
          {sumario.map((s) => <li><a href={`#${s.id}`}>{s.texto}</a></li>)}
          <li><a href="#perguntas-frequentes">Perguntas frequentes</a></li>
        </ol>
      </nav>

      <slot />

      <section class="g-autora" aria-labelledby="g-autora-titulo">
        <img
          src="/kelly-pinheiro/kelly-pinheiro-retrato-sorriso-800.webp"
          width="800" height="1208" loading="lazy" decoding="async"
          alt="Kelly Pinheiro sorrindo, de roupa preta, sentada em uma poltrona de madeira"
        />
        <div>
          <h2 class="g-autora-nome" id="g-autora-titulo">Quem escreve: <a href={URL_KELLY} rel="author">Kelly Pinheiro</a></h2>
          <p>Jornalista desde 2004, Kelly fundou a Mclair em São Paulo, em janeiro de 2017. Foi colunista da Exame por dois anos e meio e conduz pessoalmente a estratégia de imprensa dos clientes da agência. Este guia reúne o que ela repete nas primeiras conversas com quem quer levar a empresa à imprensa.</p>
        </div>
      </section>

      <section class="g-faq" id="perguntas-frequentes" aria-labelledby="g-faq-titulo">
        <h2 class="g-h2" id="g-faq-titulo">Perguntas frequentes</h2>
        {faq.map((q, i) => (
          <details class="g-faq-item" open={i === 0}>
            <summary>{q.pergunta}</summary>
            <p>{q.resposta}</p>
          </details>
        ))}
      </section>
    </div>
  </div>

  <section class="g-fim" aria-labelledby="g-fim-titulo">
    <div class="container"><div class="g-corpo">
      <h2 class="g-h2 g-claro" id="g-fim-titulo">{fimTitulo}</h2>
      <p>{fimTexto}</p>
      <div class="g-fim-acoes">
        <a href={wa} class="btn-primary" target="_blank" rel="noopener">Falar no WhatsApp</a>
        <a href={URL_HUB_ASSESSORIA} class="g-link-claro">Como funciona a assessoria da Mclair</a>
        <a href={URL_PRECO} class="g-link-claro">Quanto custa</a>
      </div>
    </div></div>
  </section>

  <section class="g-mais" aria-labelledby="g-mais-titulo">
    <div class="container"><div class="g-corpo">
      <h2 class="g-h2" id="g-mais-titulo">Outros guias</h2>
      <ul class="g-lista-guias">
        {outros.map((g) => (
          <li>
            <a href={g.path}>{g.titulo}</a>
            <p>{g.resumo}</p>
          </li>
        ))}
      </ul>
      <p class="g-nota"><a href={URL_GUIAS}>Ver todos os guias</a></p>
    </div></div>
  </section>
</article>
</Layout>

<style is:global>
.g-hero { background: var(--dark); padding-top: 88px; }
.g-hero-inner { padding-block: clamp(44px, 6vw, 80px); max-width: 860px; }
.g-trilha { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: .9rem; color: rgba(255,255,255,.5); margin-bottom: 18px; }
.g-trilha a { color: rgba(255,255,255,.65); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.25); }
.g-trilha a:hover { color: #fff; }
.g-h1 { font-size: clamp(2.1rem, 4.6vw, 3.5rem); font-weight: 900; letter-spacing: -.04em; line-height: 1.06; color: #fff; margin-bottom: 22px; text-wrap: balance; }
.g-resposta { font-size: clamp(1.08rem, 1.5vw, 1.25rem); line-height: 1.7; color: rgba(255,255,255,.88); max-width: 720px; margin-bottom: 26px; text-wrap: pretty; }
.g-assinatura { font-size: .95rem; line-height: 1.65; color: rgba(255,255,255,.62); max-width: 720px; }
.g-assinatura a { color: #fff; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255,255,255,.35); }
.g-datas { display: block; }

.g-corpo { max-width: 760px; }
.g-artigo > .container > .g-corpo { padding-block: clamp(40px, 5vw, 64px) clamp(56px, 7vw, 88px); }

.g-sumario { padding: 4px 0 6px; margin-bottom: 8px; }
.g-sumario-titulo { font-size: 1rem; font-weight: 800; color: var(--ink); margin-bottom: 10px; }
.g-sumario ol { list-style: decimal; padding-left: 1.3em; margin: 0; display: grid; gap: 6px; }
.g-sumario li { font-size: 1rem; line-height: 1.5; color: var(--ink-3); padding-left: 4px; }
.g-sumario a { color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); }
.g-sumario a:hover { color: var(--red); text-decoration-color: var(--red); }

.g-secao { scroll-margin-top: 96px; }
.g-h2 { font-size: clamp(1.55rem, 2.8vw, 2.2rem); font-weight: 900; letter-spacing: -.03em; line-height: 1.12; color: var(--ink); margin: clamp(48px, 6vw, 68px) 0 18px; text-wrap: balance; }
.g-h3 { font-size: 1.18rem; font-weight: 800; letter-spacing: -.015em; line-height: 1.3; color: var(--ink); margin: 30px 0 8px; text-wrap: balance; }
.g-p { font-size: clamp(1.02rem, 1.25vw, 1.1rem); line-height: 1.8; color: var(--ink-2); margin-bottom: 1.1em; text-wrap: pretty; }
.g-p strong { color: var(--ink); }
.g-p a, .g-lista a, .g-passos a, .g-tabela a, .g-chamada a:not(.btn-primary), .g-nota a, .g-faq-item a { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.g-p a:hover, .g-lista a:hover, .g-passos a:hover, .g-tabela a:hover, .g-chamada a:not(.btn-primary):hover, .g-nota a:hover { color: var(--red); text-decoration-color: var(--red); }

/* Lista com linhas finas, no padrão do hub de assessoria */
.g-lista { list-style: none; padding: 0; margin: 6px 0 1.4em; }
.g-lista li { padding: 14px 0; font-size: 1.02rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }
.g-lista strong { color: var(--ink); }

/* Passos numerados */
.g-passos { list-style: none; counter-reset: passo; padding: 0; margin: 6px 0 1.4em; }
.g-passos > li { counter-increment: passo; position: relative; padding: 16px 0 16px 46px; font-size: 1.02rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }
.g-passos > li::before { content: counter(passo); position: absolute; left: 0; top: 15px; font-size: 1.15rem; font-weight: 900; color: var(--red); width: 30px; }
.g-passos strong { color: var(--ink); }

/* Tabela: rola dentro da própria caixa no celular, nunca a página */
.g-tabela-caixa { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 10px 0 1.6em; }
.g-tabela { width: 100%; min-width: 0; border-collapse: collapse; font-size: .98rem; line-height: 1.55; }
.g-tabela caption { text-align: left; font-size: .92rem; color: var(--ink-3); padding-bottom: 10px; caption-side: top; }
.g-tabela th, .g-tabela td { text-align: left; vertical-align: top; padding: 12px 14px 12px 0; border-bottom: 1px solid var(--line); color: var(--ink-2); }
.g-tabela thead th { font-weight: 800; color: var(--ink); border-bottom: 2px solid var(--ink); }
.g-tabela tbody th { font-weight: 700; color: var(--ink); }
.g-tabela-larga { min-width: 520px; }
.g-tabela th[scope="row"] { width: 38%; }

/* Chamada discreta no meio do texto */
.g-chamada { background: var(--cream-2); border-radius: var(--r-md); padding: clamp(22px, 3.5vw, 32px); margin: clamp(40px, 5vw, 56px) 0; }
.g-chamada-titulo { font-size: 1.15rem; font-weight: 800; letter-spacing: -.015em; line-height: 1.35; color: var(--ink); margin-bottom: 8px; text-wrap: balance; }
.g-chamada p { font-size: 1rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }
.g-chamada-acoes { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; margin-top: 16px; }
.g-chamada-acoes a:not(.btn-primary) { font-size: .95rem; font-weight: 700; }

/* Modelo de release */
.g-modelo { margin: 16px 0 1.6em; }
.g-modelo-aviso { font-size: .95rem; line-height: 1.6; color: var(--ink-3); margin-bottom: 14px; }
.g-modelo-parte { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 0 28px; padding: 18px 0; border-top: 1px solid var(--line); }
.g-modelo-parte:last-child { border-bottom: 1px solid var(--line); }
.g-modelo-texto { background: #fff; border: 1px solid var(--line-2); border-radius: var(--r-md); padding: 16px 18px; font-size: 1rem; line-height: 1.7; color: var(--ink); text-wrap: pretty; }
.g-modelo-texto p + p { margin-top: .8em; }
.g-modelo-rotulo { display: block; font-size: .85rem; font-weight: 800; color: var(--ink-3); margin-bottom: 6px; }
.g-modelo-titulo { font-size: 1.2rem; font-weight: 900; line-height: 1.3; letter-spacing: -.015em; }
.g-modelo-com { font-size: .97rem; line-height: 1.7; color: var(--ink-2); padding-top: 4px; text-wrap: pretty; }
.g-modelo-com strong { color: var(--ink); }

.g-nota { margin-top: 24px; font-size: 1rem; line-height: 1.7; color: var(--ink-3); text-wrap: pretty; }

/* Quem escreve */
.g-autora { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 22px; align-items: start; margin-top: clamp(48px, 6vw, 72px); padding: 26px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.g-autora img { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; object-position: 50% 18%; }
.g-autora-nome { font-size: 1.15rem; font-weight: 800; color: var(--ink); line-height: 1.35; margin-bottom: 8px; text-wrap: balance; }
.g-autora-nome a { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.g-autora p { font-size: 1rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }

/* FAQ */
.g-faq { scroll-margin-top: 96px; }
.g-faq-item { border-top: 1px solid var(--line); }
.g-faq-item:last-child { border-bottom: 1px solid var(--line); }
.g-faq-item summary { cursor: pointer; list-style: none; padding: 20px 40px 20px 0; position: relative; font-size: 1.08rem; font-weight: 700; color: var(--ink); letter-spacing: -.01em; line-height: 1.4; text-wrap: balance; }
.g-faq-item summary::-webkit-details-marker { display: none; }
.g-faq-item summary::after { content: '+'; position: absolute; right: 4px; top: 18px; font-size: 1.5rem; font-weight: 300; color: var(--red); line-height: 1; transition: transform .25s; }
.g-faq-item[open] summary::after { transform: rotate(45deg); }
.g-faq-item p { padding: 0 40px 22px 0; font-size: 1.02rem; line-height: 1.75; color: var(--ink-2); text-wrap: pretty; }

/* Fechamento */
.g-fim { background: var(--dark); padding-block: clamp(56px, 7vw, 92px); }
.g-fim .g-h2 { margin-top: 0; }
.g-claro { color: #fff; }
.g-fim p { font-size: clamp(1.04rem, 1.4vw, 1.18rem); font-weight: 300; line-height: 1.7; color: rgba(255,255,255,.82); margin-bottom: 28px; text-wrap: pretty; }
.g-fim-acoes { display: flex; gap: 14px 26px; align-items: center; flex-wrap: wrap; }
.g-link-claro { font-size: .95rem; font-weight: 700; color: #fff; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(255,255,255,.45); }
.g-link-claro:hover { text-decoration-color: #fff; }

/* Outros guias */
.g-mais { background: #fff; padding-block: clamp(48px, 6vw, 80px); }
.g-mais .g-h2 { margin-top: 0; }
.g-lista-guias { list-style: none; padding: 0; margin: 0; }
.g-lista-guias li { padding: 18px 0; }
.g-lista-guias a { font-size: 1.2rem; font-weight: 800; letter-spacing: -.015em; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); text-wrap: balance; }
.g-lista-guias a:hover { color: var(--red); }
.g-lista-guias p { margin-top: 6px; font-size: 1rem; line-height: 1.65; color: var(--ink-3); text-wrap: pretty; }

@media (max-width: 760px) {
  .g-modelo-parte { grid-template-columns: 1fr; gap: 12px; }
}
@media (max-width: 640px) {
  .g-hero-inner { padding-block: 36px 44px; }
  .g-h1 { font-size: clamp(1.95rem, 8.6vw, 2.5rem); }
  .g-h2 { font-size: clamp(1.45rem, 6.6vw, 1.8rem); }
  .g-autora { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; }
  .g-autora img { width: 72px; height: 72px; }
  .g-faq-item summary { font-size: 1.02rem; padding-right: 34px; }
  .g-faq-item p { padding-right: 0; }
  .g-fim-acoes { flex-direction: column; align-items: stretch; }
  .g-fim-acoes .btn-primary { justify-content: center; }
  .g-chamada-acoes .btn-primary { width: 100%; justify-content: center; box-sizing: border-box; }
}
</style>
