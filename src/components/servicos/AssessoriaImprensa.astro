---
// Corpo da página /servicos/assessoria-de-imprensa/: a página de
// contratação do serviço. Entra em src/pages/servicos/[...slug].astro só
// para esse slug, no lugar do bloco genérico de conteúdo, e aproveita o que
// o CMS já traz (headline, texto e lista de entregas). Toda prova citada
// aqui vem dos cases publicados em /cases/ e dos números da página /sobre/.
import { paginaDaPessoa, linkarPessoasEmTexto } from '../../utils/blogAuthors';
import { FAQ_ASSESSORIA, WA_ASSESSORIA, CIDADES_ATENDIDAS, URL_ASSESSORIA_SP, URL_ASSESSORIA_PRECO } from '../../data/assessoria-imprensa';
import { URL_ASSESSOR, URL_CRISE, URL_MEDIA_TRAINING } from '../../data/servicos-imprensa';

interface Props {
  s: { headline: string; desc: string; items: string[]; cta: string; accent: string };
}
const { s } = Astro.props;
const KELLY = paginaDaPessoa('kelly-pinheiro') ?? '/sobre/';

// Explicação de cada entrega do CMS, pela ordem em que elas aparecem lá.
// Se o painel mudar a lista, a entrega sem explicação aparece só com o nome.
// Texto fixo do código (não vem do CMS), por isso pode levar link em HTML:
// porta-vozes e crise apontam para as páginas próprias desses serviços.
const EXPLICACOES: Record<string, string> = {
  'Redação e distribuição de releases estratégicos':
    'Cada release nasce de uma pauta com interesse jornalístico, escrito como notícia, com dado, contexto e porta-voz, e vai para os jornalistas certos, não para uma lista genérica.',
  'Relacionamento com veículos, jornalistas e influenciadores':
    'Conversa direta com editores e repórteres de economia, negócios, tecnologia e das editorias que o seu público lê. É esse relacionamento que transforma um e-mail em entrevista.',
  'Gestão de clipping e monitoramento de mídia':
    'Tudo o que sai sobre a empresa, a concorrência e o setor é acompanhado, organizado e devolvido em relatório, com link e data.',
  'Posicionamento e treinamento de porta-vozes':
    `Quem fala pela empresa aprende a dar entrevista: mensagem clara, exemplos prontos e segurança diante de pergunta difícil, em TV, rádio, podcast ou por escrito. Veja como funciona o <a href="${URL_MEDIA_TRAINING}">media training</a>.`,
  'Coletivas, entrevistas e eventos de imprensa':
    'Organização de coletivas, agenda de entrevistas e cobertura de feiras e lançamentos, com a imprensa convidada e preparada.',
  'Assessoria de crise e gestão de reputação':
    `Quando a notícia é delicada, o trabalho é conduzir a narrativa, responder rápido e proteger a reputação de quem está no centro dela. Saiba mais sobre <a href="${URL_CRISE}">gestão de crise de imagem</a>.`,
};

const ETAPAS = [
  { n: '01', titulo: 'Diagnóstico', texto: 'A primeira conversa levanta o que a empresa tem para dizer, quem fala por ela e quais veículos importam para o público dela. É daí que sai a proposta, com escopo e forma de medir.' },
  { n: '02', titulo: 'Pautas e releases', texto: 'Um calendário com o que é notícia de verdade: lançamento, dado inédito, parceria, posicionamento sobre um tema em alta. Cada pauta vira release, artigo assinado ou sugestão de entrevista.' },
  { n: '03', titulo: 'Relacionamento com as redações', texto: 'A pauta vai para o jornalista que cobre aquele assunto, com conversa e acompanhamento. É o trabalho que não aparece e que decide se a matéria sai.' },
  { n: '04', titulo: 'Porta-voz preparado', texto: 'Antes da primeira entrevista, o porta-voz passa por media training e recebe briefing de cada contato: quem é o jornalista, qual é o foco, o que não pode faltar.' },
  { n: '05', titulo: 'Clipping e relatório', texto: 'Cada publicação entra no clipping. O relatório periódico mostra o que saiu, o que está em andamento e o que a imprensa está pedindo, para ajustar a estratégia no caminho.' },
];

const VEICULOS = ['Folha de S.Paulo', 'Exame', 'Valor Investe', 'Globo.com', 'CNN Brasil', 'IstoÉ Dinheiro', 'InfoMoney', 'Extra', 'SBT', 'Record TV', 'Band', 'HSM Management'];

const CASES = [
  { href: '/cases/fidalgo/', nome: 'Fidalgo Leilões', texto: 'Leilões da Caixa, da Justiça Federal e dos Correios na Folha de S.Paulo, na Exame IN e no Globo.com. Mais de 1.600 inserções desde 2022.' },
  { href: '/cases/vip-leiloes/', nome: 'VIP Leilões', texto: 'Cada parceria bancária (Caixa, Bradesco, Itaú, Santander e Correios) virou pauta no Extra, no Valor Investe, na IstoÉ Dinheiro, no InfoMoney e na Folha de S.Paulo.' },
  { href: '/cases/globo-leiloes/', nome: 'Globo Leilões', texto: '685 inserções, com cobertura simultânea em Extra, IstoÉ Dinheiro, Folha Vitória e Exame.' },
  { href: '/cases/lambda3/', nome: 'Lambda3', texto: 'Cinco anos de assessoria de imprensa e comunicação digital para a consultoria de tecnologia, com entrevistas no SBT, na Record TV, na Band e na Gazeta.' },
  { href: '/cases/diego-nogare/', nome: 'Diego Nogare', texto: 'Especialista em dados e inteligência artificial com duas matérias seguidas na home da CNN Brasil, artigo na Exame e coluna na HSM Management.' },
  { href: '/cases/claudia-elisa/', nome: 'Claudia Elisa', texto: 'Conselheira e mentora com artigo na Exame e entrevista de TV sobre empresas familiares, dentro de um projeto de marca pessoal com assessoria de imprensa.' },
];
---

<section class="ai-prova" aria-label="Veículos em que clientes da Mclair foram publicados">
  <div class="container">
    <p class="ai-prova-lead">Desde 2017, são mais de 11.600 inserções na mídia e 1.734 publicações na imprensa internacional para mais de 200 clientes. Alguns dos veículos em que eles saíram:</p>
    <ul class="ai-veiculos">
      {VEICULOS.map((v) => <li>{v}</li>)}
    </ul>
  </div>
</section>

<section class="ai-secao" id="o-que-entra">
  <div class="container ai-grid">
    <div class="ai-texto">
      <h2 class="ai-h2">{s.headline || 'O que entra no trabalho de assessoria de imprensa'}</h2>
      <p class="ai-p" set:html={linkarPessoasEmTexto(s.desc)}></p>
      <p class="ai-p">Contratar uma agência de assessoria de imprensa é contratar o caminho entre o que a sua empresa sabe fazer e o espaço editorial dos veículos que o seu cliente lê, assiste e ouve. Na Mclair, esse caminho tem seis frentes:</p>
      <dl class="ai-entregas">
        {s.items.map((item) => (
          <div class="ai-entrega">
            <dt set:html={linkarPessoasEmTexto(item)}></dt>
            {EXPLICACOES[item] && <dd set:html={EXPLICACOES[item]}></dd>}
          </div>
        ))}
      </dl>
    </div>
    <aside class="ai-lateral">
      <p class="ai-lateral-titulo">Quer uma proposta?</p>
      <p>A primeira conversa é o diagnóstico: o que a sua empresa tem para dizer e onde isso interessa. A proposta sai depois dela, com escopo e forma de medir.</p>
      <p>Para chegar à conversa sabendo como o mercado cobra, veja <a href={URL_ASSESSORIA_PRECO}>quanto custa uma assessoria de imprensa</a>.</p>
      <a href={WA_ASSESSORIA} class="btn-primary" target="_blank" rel="noopener">{s.cta || 'Falar com a Mclair'}</a>
    </aside>
  </div>
</section>

<section class="ai-secao ai-secao-escura" id="como-funciona">
  <div class="container">
    <h2 class="ai-h2 ai-h2-claro">Como funciona, do diagnóstico à primeira matéria</h2>
    <ol class="ai-etapas">
      {ETAPAS.map((e) => (
        <li>
          <span class="ai-etapa-n" aria-hidden="true">{e.n}</span>
          <h3>{e.titulo}</h3>
          <p>{e.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="ai-secao" id="cases">
  <div class="container">
    <h2 class="ai-h2">Onde nossos clientes já saíram</h2>
    <p class="ai-p ai-p-intro">Cada case abaixo tem a matéria publicada, com veículo e data, na própria página. É a prova que vale mais do que qualquer promessa.</p>
    <ul class="ai-cases">
      {CASES.map((c) => (
        <li>
          <h3><a href={c.href}>{c.nome}</a></h3>
          <p>{c.texto}</p>
          <a class="ai-case-link" href={c.href}>Ver o case</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="ai-secao ai-secao-vermelha" id="internacional">
  <div class="container ai-grid-inter">
    <div>
      <h2 class="ai-h2 ai-h2-claro">Assessoria de imprensa internacional</h2>
      <p class="ai-p">Poucas agências brasileiras têm um caso de imprensa estrangeira para mostrar. O da Mclair é o programa Brazil Machinery Solutions, parceria da ABIMAQ com a ApexBrasil para promover as exportações da indústria de máquinas e equipamentos.</p>
      <p class="ai-p">O trabalho foi feito com correspondentes estrangeiros e jornalistas de comércio internacional, conteúdo em português e inglês e cobertura planejada por região e setor, incluindo feiras como a Agrishow. O resultado: mais de 2 mil inserções, 1.734 publicações na imprensa internacional, mais de 15 países alcançados e R$ 9,14 milhões em retorno de mídia.</p>
      <a href="/cases/bms-abimaq/" class="ai-link-claro">Ver o case BMS / ABIMAQ + ApexBrasil</a>
    </div>
    <figure class="ai-inter-foto">
      <img src="/cases-img/bms-abimaq-1.webp" alt="Cobertura de imprensa do programa Brazil Machinery Solutions, da ABIMAQ com a ApexBrasil" loading="lazy" decoding="async" width="800" height="600" />
    </figure>
  </div>
</section>

<section class="ai-secao" id="quem-cuida">
  <div class="container ai-grid-kelly">
    <figure class="ai-kelly-foto">
      <img src="/kelly-pinheiro/kelly-pinheiro-escritorio-oculos-800.webp" srcset="/kelly-pinheiro/kelly-pinheiro-escritorio-oculos-800.webp 800w, /kelly-pinheiro/kelly-pinheiro-escritorio-oculos-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 360px" width="1600" height="2400" alt="Kelly Pinheiro, CEO da Mclair, à mesa do escritório da agência" loading="lazy" decoding="async" />
    </figure>
    <div>
      <h2 class="ai-h2">Quem cuida da sua conta</h2>
      <p class="ai-p">A estratégia de cada cliente passa por <a href={KELLY} class="pessoa-link">Kelly Pinheiro</a>, jornalista desde 2004, CEO e sócia-fundadora da Mclair. Antes de abrir a agência, em 2017, ela atuou em comunicação corporativa, gestão de conteúdo e gerenciamento de crise para instituições governamentais e empresas nacionais e multinacionais. Foi colunista da Exame por dois anos e meio, o que ajuda a saber, do lado de dentro, o que uma redação aceita e o que descarta.</p>
      <p class="ai-p">A conta é atendida por uma equipe de jornalistas, com Kelly à frente da relação com o cliente. <a href={KELLY}>Conheça a trajetória de Kelly Pinheiro</a>.</p>
      <p class="ai-p">Ainda decidindo entre um jornalista freelancer e uma agência? A página sobre como <a href={URL_ASSESSOR}>contratar assessor de imprensa</a> compara os dois formatos.</p>
    </div>
  </div>
</section>

<section class="ai-secao ai-secao-creme" id="para-quem">
  <div class="container ai-grid-2">
    <div>
      <h2 class="ai-h2">Para quem a assessoria de imprensa funciona</h2>
      <ul class="ai-lista">
        <li>Empresas com algo novo para contar: lançamento, parceria, dado de mercado, expansão. Foi assim com as leiloeiras que viram notícia a cada praça.</li>
        <li>Setores técnicos que a imprensa cobre pouco e precisa de fonte: tecnologia, dados, máquinas e equipamentos, finanças.</li>
        <li>Executivos e especialistas que querem ser a referência chamada pela imprensa quando o assunto deles entra em pauta.</li>
        <li>Marcas que passam por um momento sensível e precisam conduzir a narrativa com cuidado, com <a href={URL_CRISE}>gestão de crise</a>.</li>
      </ul>
    </div>
    <div>
      <h2 class="ai-h2">Para quem não funciona</h2>
      <ul class="ai-lista">
        <li>Quem quer publicação garantida em um veículo escolhido. Espaço editorial não se compra, e quem promete isso está vendendo outra coisa.</li>
        <li>Quem espera anúncio disfarçado de notícia. O jornalista percebe e a marca perde credibilidade.</li>
        <li>Quem não terá um porta-voz disponível para entrevistas. Sem quem fale pela empresa, a pauta para na redação.</li>
        <li>Quem precisa de resultado imediato e não de presença consistente. Assessoria de imprensa constrói reputação com o tempo, matéria a matéria.</li>
      </ul>
    </div>
  </div>
</section>

<section class="ai-secao" id="perguntas-frequentes">
  <div class="container ai-faq-wrap">
    <h2 class="ai-h2">Perguntas de quem vai contratar</h2>
    <div class="ai-faq">
      {FAQ_ASSESSORIA.map((q, i) => (
        <details class="ai-faq-item" open={i === 0}>
          <summary>{q.pergunta}</summary>
          <p>{q.resposta}</p>
        </details>
      ))}
    </div>
    <p class="ai-cidades">Base em São Paulo (veja a <a href={URL_ASSESSORIA_SP}>assessoria de imprensa em São Paulo</a>), atendimento remoto para o Brasil todo, com clientes e pautas em {CIDADES_ATENDIDAS.slice(0, -1).join(', ')} e {CIDADES_ATENDIDAS[CIDADES_ATENDIDAS.length - 1]}, entre outras cidades.</p>
  </div>
</section>

<section class="ai-fim">
  <div class="container ai-fim-inner">
    <h2 class="ai-h2 ai-h2-claro">Vamos colocar a sua empresa na pauta?</h2>
    <p>Conte o que a sua empresa tem para dizer. A primeira conversa é o diagnóstico, sem compromisso, e a proposta vem depois.</p>
    <div class="ai-fim-acoes">
      <a href={WA_ASSESSORIA} class="btn-primary" target="_blank" rel="noopener">Falar no WhatsApp</a>
      <a href="/contato/" class="ai-link-claro">Ou envie uma mensagem</a>
    </div>
  </div>
</section>

<style>
.ai-h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); font-weight: 900; letter-spacing: -.035em; line-height: 1.08; color: var(--ink); margin-bottom: 22px; text-wrap: balance; }
.ai-h2-claro { color: #fff; }
.ai-p { font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.8; color: var(--ink-2); margin-bottom: 1.2em; text-wrap: pretty; }
.ai-p a { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.ai-p a:hover { color: var(--red); text-decoration-color: var(--red); }
.ai-p-intro { max-width: 680px; margin-bottom: 36px; }
.ai-secao { padding-block: clamp(64px, 8vw, 110px); background: #fff; }
.ai-secao-creme { background: var(--cream); }
.ai-secao-escura { background: var(--dark); }
.ai-secao-escura .ai-p { color: rgba(255,255,255,.8); }
.ai-secao-vermelha { background: var(--red); }
.ai-secao-vermelha .ai-p { color: rgba(255,255,255,.92); }
.ai-link-claro { font-size: .95rem; font-weight: 700; color: #fff; text-decoration: underline; text-underline-offset: 5px; text-decoration-color: rgba(255,255,255,.45); }
.ai-link-claro:hover { text-decoration-color: #fff; }

/* Prova logo abaixo do hero: números em prosa e os veículos em texto grande. */
.ai-prova { background: var(--cream); padding-block: clamp(40px, 5vw, 64px); border-bottom: 1px solid var(--line); }
.ai-prova-lead { font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.7; color: var(--ink-2); max-width: 760px; margin-bottom: 22px; text-wrap: pretty; }
.ai-veiculos { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px 28px; }
.ai-veiculos li { font-size: clamp(1.15rem, 1.9vw, 1.7rem); font-weight: 900; letter-spacing: -.03em; color: var(--ink-4); line-height: 1.3; }

/* O que entra */
.ai-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(40px, 6vw, 96px); align-items: start; }
.ai-entregas { margin: 28px 0 0; }
.ai-entrega { padding: 20px 0; border-top: 1px solid var(--line); }
.ai-entrega:last-child { border-bottom: 1px solid var(--line); }
.ai-entrega dt { font-size: 1.12rem; font-weight: 700; color: var(--ink); margin-bottom: 6px; letter-spacing: -.01em; }
.ai-entrega dd { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--ink-3); }
.ai-lateral { position: sticky; top: 110px; padding: 28px; background: var(--cream); }
.ai-lateral-titulo { font-size: 1.25rem; font-weight: 900; letter-spacing: -.02em; color: var(--ink); margin-bottom: 10px; }
.ai-lateral p:not(.ai-lateral-titulo) { font-size: .98rem; line-height: 1.7; color: var(--ink-3); margin-bottom: 20px; }

/* Etapas */
.ai-etapas { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 32px; }
.ai-etapas li { padding-top: 18px; border-top: 1px solid rgba(255,255,255,.22); }
.ai-etapa-n { display: block; font-size: .85rem; font-weight: 700; color: var(--red); letter-spacing: .04em; margin-bottom: 10px; }
.ai-etapas h3 { font-size: 1.2rem; font-weight: 800; color: #fff; letter-spacing: -.02em; margin-bottom: 10px; }
.ai-etapas p { font-size: .96rem; line-height: 1.7; color: rgba(255,255,255,.72); }

/* Cases */
.ai-cases { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 56px; }
.ai-cases li { padding: 24px 0 26px; border-top: 1px solid var(--line); }
.ai-cases h3 { font-size: 1.3rem; font-weight: 900; letter-spacing: -.03em; margin-bottom: 8px; }
.ai-cases h3 a { color: var(--ink); }
.ai-cases h3 a:hover { color: var(--red); }
.ai-cases p { font-size: 1rem; line-height: 1.7; color: var(--ink-3); margin-bottom: 10px; text-wrap: pretty; }
.ai-case-link { font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--red); }
.ai-case-link:hover { text-decoration: underline; text-underline-offset: 4px; }

/* Internacional */
.ai-grid-inter { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 42%); gap: clamp(40px, 6vw, 96px); align-items: center; }
.ai-inter-foto { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; }
.ai-inter-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Kelly */
.ai-grid-kelly { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
.ai-kelly-foto { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
.ai-kelly-foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; display: block; }

/* Para quem é / não é */
.ai-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
.ai-lista { list-style: none; padding: 0; margin: 0; }
.ai-lista li { padding: 16px 0; border-top: 1px solid var(--line-2); font-size: 1.02rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }
.ai-lista li:last-child { border-bottom: 1px solid var(--line-2); }

/* FAQ */
.ai-faq-wrap { max-width: 860px; }
.ai-faq-item { border-top: 1px solid var(--line); }
.ai-faq-item:last-child { border-bottom: 1px solid var(--line); }
.ai-faq-item summary {
  cursor: pointer; list-style: none; padding: 20px 40px 20px 0; position: relative;
  font-size: 1.12rem; font-weight: 700; color: var(--ink); letter-spacing: -.01em; line-height: 1.4; text-wrap: balance;
}
.ai-faq-item summary::-webkit-details-marker { display: none; }
.ai-faq-item summary::after {
  content: '+'; position: absolute; right: 4px; top: 18px;
  font-size: 1.5rem; font-weight: 300; color: var(--red); line-height: 1; transition: transform .25s;
}
.ai-faq-item[open] summary::after { transform: rotate(45deg); }
.ai-faq-item p { padding: 0 40px 24px 0; font-size: 1.02rem; line-height: 1.75; color: var(--ink-2); text-wrap: pretty; }
.ai-lateral p a, .ai-cidades a, .ai-entrega dd a, .ai-lista a { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.ai-lateral p a:hover, .ai-cidades a:hover, .ai-entrega dd a:hover, .ai-lista a:hover { color: var(--red); text-decoration-color: var(--red); }
.ai-cidades { margin-top: 32px; font-size: .95rem; line-height: 1.7; color: var(--ink-3); text-wrap: pretty; }

/* Fechamento */
.ai-fim { background: var(--dark); padding-block: clamp(64px, 8vw, 110px); }
.ai-fim-inner { max-width: 760px; }
.ai-fim p { font-size: clamp(1.05rem, 1.4vw, 1.2rem); font-weight: 300; line-height: 1.7; color: rgba(255,255,255,.8); margin-bottom: 32px; }
.ai-fim-acoes { display: flex; gap: 16px 28px; align-items: center; flex-wrap: wrap; }

@media (max-width: 1024px) {
  .ai-etapas { grid-template-columns: repeat(3, 1fr); }
  .ai-grid-kelly { grid-template-columns: 300px minmax(0, 1fr); }
}
@media (max-width: 900px) {
  .ai-grid, .ai-grid-inter, .ai-grid-kelly, .ai-grid-2 { grid-template-columns: 1fr; }
  .ai-lateral { position: static; }
  .ai-kelly-foto { max-width: 420px; aspect-ratio: 3 / 2; }
  .ai-inter-foto { aspect-ratio: 3 / 2; }
  .ai-cases { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .ai-secao, .ai-fim { padding-block: 52px; }
  .ai-h2 { font-size: clamp(1.6rem, 7.2vw, 2rem); }
  .ai-veiculos { gap: 4px 18px; }
  .ai-veiculos li { font-size: 1.1rem; }
  .ai-etapas { grid-template-columns: 1fr; gap: 20px; }
  .ai-entrega dt { font-size: 1.05rem; }
  .ai-faq-item summary { font-size: 1.02rem; padding-right: 34px; }
  .ai-faq-item p { padding-right: 0; }
  .ai-fim-acoes { flex-direction: column; align-items: stretch; }
  .ai-fim-acoes .btn-primary { justify-content: center; }
}
</style>
