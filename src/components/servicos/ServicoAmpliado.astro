---
// Corpo ampliado das cinco páginas de serviço antigas que vêm do CMS
// (marketing de autoridade, branding, marketing digital, consultoria e
// mentorias). Entra em src/pages/servicos/[...slug].astro só para os slugs
// de SERVICOS_AMPLIADOS, no lugar do bloco genérico, no mesmo esquema da
// página de assessoria de imprensa (AssessoriaImprensa.astro): o CMS segue
// mandando no hero, no headline, no texto e na lista de entregas; o texto
// próprio, os cases, o FAQ e o formulário vêm de src/data/servicos-ampliados.ts.
import { linkarPessoasEmTexto } from '../../utils/blogAuthors';
import FormServico from './FormServico.astro';
import { AVISO_FORM, type ServicoAmpliado } from '../../data/servicos-ampliados';

interface Props {
  s: { headline: string; desc: string; items: string[]; cta: string };
  d: ServicoAmpliado;
}
const { s, d } = Astro.props;
const FORM = '#fale-com-a-mclair';
const foto = `/kelly-pinheiro/${d.kelly.foto}`;
---

<section class="sa-secao" id="o-servico">
  <div class="container sa-grid">
    <div class="sa-texto">
      <h2 class="sa-h2">{d.aberturaTitulo}</h2>
      {d.abertura.map((p) => <p class="sa-p" set:html={p}></p>)}
    </div>
    <aside class="sa-lateral" aria-label="Pedir proposta">
      <p class="sa-lateral-titulo">Vamos conversar?</p>
      <p>{d.lateral}</p>
      <a href={d.wa} class="btn-primary" target="_blank" rel="noopener">{s.cta || 'Falar com a Mclair'}</a>
      <a href={FORM} class="sa-lateral-link">Ou deixe seus dados</a>
    </aside>
  </div>
</section>

<section class="sa-secao sa-secao-creme" id="o-que-entra">
  <div class="container"><div class="sa-estreito">
    {s.headline && <h2 class="sa-h2">{s.headline}</h2>}
    {s.desc && <p class="sa-p" set:html={linkarPessoasEmTexto(s.desc)}></p>}
    {s.items.length > 0 && (
      <>
        <p class="sa-p">{d.entregasIntro}</p>
        <dl class="sa-entregas">
          {s.items.map((item) => (
            <div>
              <dt set:html={linkarPessoasEmTexto(item)}></dt>
              {d.explicacoes[item] && <dd set:html={d.explicacoes[item]}></dd>}
            </div>
          ))}
        </dl>
      </>
    )}
  </div></div>
</section>

<section class="sa-secao sa-secao-escura" id="como-funciona">
  <div class="container"><div class="sa-estreito">
    <h2 class="sa-h2 sa-claro">{d.etapasTitulo}</h2>
    {d.etapasIntro && <p class="sa-p">{d.etapasIntro}</p>}
    <ol class="sa-etapas">
      {d.etapas.map((e, i) => (
        <li>
          <span class="sa-etapa-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3>{e.titulo}</h3>
            <p set:html={e.texto}></p>
          </div>
        </li>
      ))}
    </ol>
  </div></div>
</section>

<section class="sa-secao" id="cases">
  <div class="container"><div class="sa-estreito">
    <h2 class="sa-h2">{d.casesTitulo}</h2>
    <p class="sa-p">{d.casesIntro}</p>
    <ul class="sa-cases">
      {d.cases.map((c) => (
        <li>
          <h3><a href={c.href}>{c.nome}</a></h3>
          <p>{c.texto} <a class="sa-case-link" href={c.href}>Ver o case</a></p>
        </li>
      ))}
    </ul>
  </div></div>
</section>

<section class="sa-secao sa-secao-creme" id="para-quem">
  <div class="container sa-grid-2">
    <div>
      <h2 class="sa-h2">{d.paraQuem.titulo}</h2>
      <ul class="sa-lista">{d.paraQuem.itens.map((t) => <li set:html={t}></li>)}</ul>
    </div>
    <div>
      <h2 class="sa-h2">{d.naoE.titulo}</h2>
      <ul class="sa-lista">{d.naoE.itens.map((t) => <li set:html={t}></li>)}</ul>
    </div>
  </div>
</section>

<section class="sa-secao" id="quem-conduz">
  <div class="container sa-grid-kelly">
    <figure class="sa-kelly-foto">
      <img src={`${foto}-800.webp`} srcset={`${foto}-800.webp 800w, ${foto}-1600.webp 1600w`} sizes="(max-width: 900px) 100vw, 360px" width="800" height="1200" alt={d.kelly.alt} loading="lazy" decoding="async" />
    </figure>
    <div>
      <h2 class="sa-h2">Quem conduz</h2>
      {d.kelly.paragrafos.map((p) => <p class="sa-p" set:html={p}></p>)}
      <p class="sa-p"><a href="/kelly-pinheiro/">Conheça a trajetória de Kelly Pinheiro</a>.</p>
    </div>
  </div>
</section>

<section class="sa-secao sa-secao-creme" id="perguntas-frequentes">
  <div class="container"><div class="sa-estreito">
    <h2 class="sa-h2">{d.faqTitulo}</h2>
    <div class="sa-faq">
      {d.faq.map((q, i) => (
        <details class="sa-faq-item" open={i === 0}>
          <summary>{q.pergunta}</summary>
          <p>{q.resposta}</p>
        </details>
      ))}
    </div>
  </div></div>
</section>

<div class="sa-form">
  <FormServico
    id={d.form.id}
    ancora="fale-com-a-mclair"
    titulo={d.form.titulo}
    assunto={d.form.assunto}
    waIntro={d.form.waIntro}
    perguntaLabel={d.form.perguntaLabel}
    perguntaDica={d.form.perguntaDica}
    perguntaRotulo={d.form.perguntaRotulo}
    opcoesLabel={d.form.opcoesLabel}
    opcoes={d.form.opcoes}
    opcoesRotulo={d.form.opcoesRotulo}
  >
    <p class="af-p">{d.form.texto}</p>
    <p class="af-p">{AVISO_FORM}</p>
    <p class="af-p">Prefere conversar direto? <a href={d.wa} target="_blank" rel="noopener">Fale pelo WhatsApp</a>.</p>
  </FormServico>
</div>

<style>
.sa-secao { padding-block: clamp(64px, 8vw, 110px); background: #fff; }
.sa-secao-creme { background: var(--cream); }
.sa-secao-escura { background: var(--dark); }
.sa-secao-escura .sa-p { color: rgba(255,255,255,.78); }
.sa-estreito { max-width: 860px; }
.sa-h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); font-weight: 900; letter-spacing: -.035em; line-height: 1.08; color: var(--ink); margin-bottom: 22px; text-wrap: balance; }
.sa-claro { color: #fff; }
.sa-p { font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.8; color: var(--ink-2); margin-bottom: 1.2em; text-wrap: pretty; }
.sa-p :global(a), .sa-lista :global(a), .sa-entregas :global(dd a), .sa-etapas :global(a) { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.sa-p :global(a:hover), .sa-lista :global(a:hover), .sa-entregas :global(dd a:hover), .sa-etapas :global(a:hover) { color: var(--red); text-decoration-color: var(--red); }

.sa-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(40px, 6vw, 96px); align-items: start; }
.sa-texto { max-width: 760px; }
.sa-lateral { position: sticky; top: 110px; padding: 28px; background: var(--cream); display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
.sa-lateral-titulo { font-size: 1.25rem; font-weight: 900; letter-spacing: -.02em; color: var(--ink); }
.sa-lateral p:not(.sa-lateral-titulo) { font-size: .98rem; line-height: 1.7; color: var(--ink-3); }
.sa-lateral-link { font-size: .95rem; font-weight: 700; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.sa-lateral-link:hover { color: var(--red); }

.sa-entregas { margin: 8px 0 0; }
.sa-entregas > div { padding: 20px 0; }
.sa-entregas dt { font-size: 1.12rem; font-weight: 700; color: var(--ink); margin-bottom: 6px; letter-spacing: -.01em; text-wrap: balance; }
.sa-entregas dd { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--ink-3); text-wrap: pretty; }

.sa-etapas { list-style: none; padding: 0; margin: 12px 0 0; }
.sa-etapas li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 8px; padding: 22px 0; }
.sa-etapa-n { font-size: .9rem; font-weight: 700; color: var(--red); letter-spacing: .04em; padding-top: 4px; }
.sa-etapas h3 { font-size: 1.2rem; font-weight: 800; color: #fff; letter-spacing: -.02em; margin-bottom: 8px; text-wrap: balance; }
.sa-etapas p { font-size: 1rem; line-height: 1.7; color: rgba(255,255,255,.74); text-wrap: pretty; }
.sa-etapas :global(a) { color: #fff; text-decoration-color: rgba(255,255,255,.45); }

.sa-cases { list-style: none; padding: 0; margin: 8px 0 0; }
.sa-cases li { padding: 24px 0 26px; }
.sa-cases h3 { font-size: 1.3rem; font-weight: 900; letter-spacing: -.03em; margin-bottom: 8px; text-wrap: balance; }
.sa-cases h3 a { color: var(--ink); }
.sa-cases h3 a:hover { color: var(--red); }
.sa-cases p { font-size: 1.02rem; line-height: 1.75; color: var(--ink-2); text-wrap: pretty; }
.sa-case-link { font-weight: 700; color: var(--red); white-space: nowrap; text-decoration: underline; text-underline-offset: 4px; }

.sa-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
.sa-lista { list-style: none; padding: 0; margin: 0; }
.sa-lista li { padding: 16px 0; font-size: 1.02rem; line-height: 1.7; color: var(--ink-2); text-wrap: pretty; }
.sa-lista :global(strong) { color: var(--ink); }

.sa-grid-kelly { display: grid; grid-template-columns: 360px minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
.sa-kelly-foto { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
.sa-kelly-foto img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; display: block; }

.sa-faq-item { border-top: 1px solid var(--line-2); }
.sa-faq-item:last-child { border-bottom: 1px solid var(--line-2); }
.sa-faq-item summary { cursor: pointer; list-style: none; padding: 20px 40px 20px 0; position: relative; font-size: 1.12rem; font-weight: 700; color: var(--ink); letter-spacing: -.01em; line-height: 1.4; text-wrap: balance; }
.sa-faq-item summary::-webkit-details-marker { display: none; }
.sa-faq-item summary::after { content: '+'; position: absolute; right: 4px; top: 18px; font-size: 1.5rem; font-weight: 300; color: var(--red); line-height: 1; transition: transform .25s; }
.sa-faq-item[open] summary::after { transform: rotate(45deg); }
.sa-faq-item p { padding: 0 40px 24px 0; font-size: 1.02rem; line-height: 1.75; color: var(--ink-2); text-wrap: pretty; }

/* O FormServico usa as classes af-* da moldura AssessoriaFilha, que não
   entra nestas páginas. As regras abaixo valem só dentro de .sa-form. */
.sa-form :global(.af-secao) { padding-block: clamp(64px, 8vw, 110px); }
.sa-form :global(.af-secao.af-secao-creme) { background: #fff; }
.sa-form :global(.af-h2) { font-size: clamp(1.7rem, 3vw, 2.5rem); font-weight: 900; letter-spacing: -.035em; line-height: 1.08; color: var(--ink); margin-bottom: 22px; text-wrap: balance; }
.sa-form :global(.af-p) { font-size: clamp(1rem, 1.25vw, 1.1rem); line-height: 1.8; color: var(--ink-2); margin-bottom: 1.15em; text-wrap: pretty; }
.sa-form :global(.af-p a) { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(200,16,46,.45); }
.sa-form :global(.af-p a:hover) { color: var(--red); }

/* H1 do hero do [...slug] sem palavra sozinha na última linha. */
:global(.sh-title) { text-wrap: balance; }

@media (max-width: 900px) {
  .sa-grid, .sa-grid-2, .sa-grid-kelly { grid-template-columns: 1fr; }
  .sa-lateral { position: static; }
  .sa-kelly-foto { max-width: 420px; aspect-ratio: 3 / 2; }
}
@media (max-width: 640px) {
  .sa-secao, .sa-form :global(.af-secao) { padding-block: 52px; }
  .sa-h2, .sa-form :global(.af-h2) { font-size: clamp(1.6rem, 7.2vw, 2rem); }
  .sa-etapas li { grid-template-columns: 40px minmax(0, 1fr); }
  .sa-faq-item summary { font-size: 1.02rem; padding-right: 34px; }
  .sa-faq-item p { padding-right: 0; }
  .sa-lateral { align-items: stretch; }
  .sa-lateral .btn-primary { justify-content: center; }
}
</style>
