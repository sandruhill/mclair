<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/

  RewriteRule ^posts/editar/?$ edit.php [L,QSA]
  RewriteRule ^posts/?$ index.php [L,QSA]
  RewriteRule ^casos/?$ cases.php [L,QSA]
  RewriteRule ^servicos/?$ services.php [L,QSA]
  RewriteRule ^paginas/?$ pages.php [L,QSA]
  RewriteRule ^usuarios/?$ users.php [L,QSA]
  RewriteRule ^configuracoes/?$ settings.php [L,QSA]
</IfModule>

<Files "config.php">
  Require all denied
</Files>

<Files "_layout_top.php">
  Require all denied
</Files>

<Files "db.php">
  Require all denied
</Files>

<Files "auth.php">
  Require all denied
</Files>
