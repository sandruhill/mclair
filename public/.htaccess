  RewriteRule ^blog-detalhe\.php$ /blog/leilao-do-bradesco-traz-52-imoveis-com-precos-a-partir-de-r-40-mil/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=287(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/do-glp-ao-coracao-dos-corinthianos-como-o-patrocinio-do-appgas-ao-tima/ [R=301,L,QSD]
