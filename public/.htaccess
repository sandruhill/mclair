# Security headers — the equivalent vercel.json config stopped applying once
# deploy moved from Vercel to plain static hosting on Hostinger/Apache.
# /acesso/ (the CMS admin) gets its own .htaccess with its own CSP.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Old PHP-era URLs (pre-Astro site) -> current routes, so any surviving
  # backlinks/bookmarks/search-index entries land on real content instead
  # of a dead end.
  RewriteRule ^quem-somos\.php$ /sobre/ [R=301,L,QSD]
  RewriteRule ^contato\.php$ /contato/ [R=301,L,QSD]
  RewriteRule ^servicos\.php$ /servicos/ [R=301,L,QSD]
  RewriteRule ^blog\.php$ /blog/ [R=301,L,QSD]
  RewriteRule ^index\.php$ / [R=301,L,QSD]

  # blog-detalhe.php?id=N -> matching current post, recovered from Wayback
  # Machine archives (old site never preserved these ids in the DB). Ids
  # without a confirmed match fall through to the blog index below rather
  # than guessing or sending everything to the homepage.
  RewriteCond %{QUERY_STRING} ^id=12(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/em-tempos-de-pandemia-tecnologia-cria-oportunidades/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=13(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/o-lado-b-da-produtividade-em-trabalho-remoto/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=96(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/guiando-tem-20-vagas-abertas-100-remoto-1/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=99(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/o-que-a-vida-corporativa-tem-a-ver-com-um-jogo-de-squash/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=101(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/5-perguntas-cruciais-antes-de-formar-um-conselho-administrativo-ou-con/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=108(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/perceber-nuances-o-superpoder-que-todo-lider-precisa-ter/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=124(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/cotas-para-streaming-na-franca-realca-atraso-do-brasil-na-regulamentac/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=125(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/projeto-ze-conecta-amplia-inclusao-digital-a-alunos-em-situacao-vulner/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=126(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/3-setores-beneficiados-pelo-audiovisual-em-2021/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} ^id=127(/|$|&)
  RewriteRule ^blog-detalhe\.php$ /blog/guiando-abre-novas-vagas-para-ti-e-outras-areas/ [R=301,L,QSD]
