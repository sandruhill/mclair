<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set Cache-Control "no-store"
  # CSP própria do painel: a do site (raiz) mais os mosaicos do OpenStreetMap
  # (mapa da ficha de Mensagens, Leaflet servido daqui mesmo) e blob: para
  # pré-visualização de upload. Nada de GTM nem pixel aqui dentro.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://mclair.com.br https://*.tile.openstreetmap.org https://img.youtube.com https://i.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.tiktok.com https://www.instagram.com https://player.vimeo.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /acesso/

  RewriteRule ^posts/editar/?$ edit.php [L,QSA]
  RewriteRule ^posts/novo/?$ edit.php [L,QSA]
  RewriteRule ^posts/?$ index.php [L,QSA]
  RewriteRule ^autores/?$ authors.php [L,QSA]
  RewriteRule ^casos/?$ cases.php [L,QSA]
  RewriteRule ^servicos/?$ services.php [L,QSA]
  RewriteRule ^paginas/?$ pages.php [L,QSA]
  RewriteRule ^menu/?$ menu.php [L,QSA]
  RewriteRule ^usuarios/?$ users.php [L,QSA]
  RewriteRule ^configuracoes/?$ settings.php [L,QSA]
  RewriteRule ^mensagens/?$ messages.php [L,QSA]
</IfModule>

<Files "config.php">
  Require all denied
</Files>

<Files "_layout_top.php">
  Require all denied
</Files>

<Files "_author_modal.php">
  Require all denied
</Files>

<Files "db.php">
  Require all denied
</Files>

<Files "auth.php">
  Require all denied
</Files>

<Files "mensagens-lib.php">
  Require all denied
</Files>

<Files "mmdb.php">
  Require all denied
</Files>

# O PHP da Hostinger grava "error_log" na pasta do script; pode conter
# mensagem de exceção com dado de lead. Não é para ser público.
<Files "error_log">
  Require all denied
</Files>
