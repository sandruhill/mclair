# Só esta página: libera o fundo do mapa (OpenStreetMap) e o
# Google Maps embutido que abre ao escolher uma agência. O resto da política
# é igual à da raiz (public/.htaccess). Mudou a da raiz, mude aqui também.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src https://tile.openstreetmap.org 'self' data: https://mclair.com.br https://img.youtube.com https://i.ytimg.com https://www.facebook.com https://www.google-analytics.com; frame-src https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com https://www.googletagmanager.com https://www.tiktok.com https://www.instagram.com https://player.vimeo.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://www.facebook.com https://connect.facebook.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
