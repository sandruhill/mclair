# Config file is included by fb-capi.php only — deny direct requests as
# defense in depth (PHP execution already prevents source disclosure).
<Files "fb-capi-config.php">
  Require all denied
</Files>

# O PHP da Hostinger grava "error_log" na pasta do script. As mensagens do
# contato.php não têm dado pessoal, mas o arquivo não precisa ser público.
<Files "error_log">
  Require all denied
</Files>
